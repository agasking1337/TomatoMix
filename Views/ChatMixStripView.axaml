<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:TomatoMix.Theme"
             x:Class="TomatoMix.Views.ChatMixStripView">

    <Border Classes="channel-strip"
            Margin="5,0">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <Border Padding="12,10"
                        BorderBrush="{DynamicResource TokenBorder}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="6"
                                        Background="{DynamicResource TokenSurfaceInset}">
                                    <theme:ThemeIcon Icon="Sftp"
                                                     Width="13"
                                                     Height="13"
                                                     Foreground="{DynamicResource TokenText}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="CHATMIX"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.8"
                                           Foreground="{DynamicResource TokenText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TokenSurfaceInset}"
                                    BorderBrush="{DynamicResource TokenBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <TextBlock Text="{Binding ChatMixModeBadgeText}"
                                           FontSize="9"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TokenTextMuted}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Responsive Vertical Balance Fader + Dual Game/Chat VU Meters -->
            <Border Grid.Row="1"
                    Background="Transparent"
                    Padding="12,10"
                    BorderBrush="{DynamicResource TokenBorder}"
                    BorderThickness="0,0,0,1"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">

                    <!-- Balance Readout Pill -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource TokenSurfaceInset}"
                            BorderBrush="{DynamicResource TokenBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,3"
                            HorizontalAlignment="Center"
                            MinWidth="86"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding ChatMixLabelText}"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TokenText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Vertical Crossfader + Dual Live Game/Chat VU Meters -->
                    <Grid Grid.Row="1"
                          Background="Transparent"
                          ColumnDefinitions="*,Auto,Auto,Auto,*"
                          MinHeight="70"
                          MaxHeight="200"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          ClipToBounds="True">

                        <!-- Balance Scale Labels (Top = CHAT, Center = 0, Bottom = GAME/MEDIA) -->
                        <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,4,8,4" HorizontalAlignment="Right">
                            <TextBlock Grid.Row="0" Text="CHAT" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextMuted}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="+50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Text="0" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TokenText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Text="-50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="4" Text="{Binding ChatMixTargetChannelLabel}" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- Vertical Balance Slider (-100 Game/Media .. 0 Balanced .. +100 Chat) -->
                        <Slider Grid.Column="1"
                                Orientation="Vertical"
                                Minimum="-100"
                                Maximum="100"
                                Value="{Binding ChatMixBalance}"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource TokenAccent}"
                                HorizontalAlignment="Center" />

                        <!-- Live Target (Game/Media) VU Meter -->
                        <ProgressBar Grid.Column="2"
                                     Orientation="Vertical"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding GameChannelPeakLevel}"
                                     Width="8"
                                     MinWidth="8"
                                     MinHeight="40"
                                     Margin="10,4,0,4"
                                     CornerRadius="4"
                                     Background="{DynamicResource TokenSurfaceInset}"
                                     BorderBrush="{DynamicResource TokenBorder}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource TokenAccent}"
                                     VerticalAlignment="Stretch"
                                     ToolTip.Tip="{Binding ChatMixTargetPeakTooltip}" />

                        <!-- Live Chat VU Meter -->
                        <ProgressBar Grid.Column="3"
                                     Orientation="Vertical"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ChatChannelPeakLevel}"
                                     Width="8"
                                     MinWidth="8"
                                     MinHeight="40"
                                     Margin="4,4,0,4"
                                     CornerRadius="4"
                                     Background="{DynamicResource TokenSurfaceInset}"
                                     BorderBrush="{DynamicResource TokenBorder}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource TokenTextMuted}"
                                     VerticalAlignment="Stretch"
                                     ToolTip.Tip="Live Chat Channel Level" />
                    </Grid>

                    <!-- Quick Bias & Center Reset Buttons (Matches Master/Channel Button Row) -->
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                        <Grid ColumnDefinitions="*,6,*">
                            <Button Grid.Column="0"
                                    Classes="sonar-btn"
                                    Command="{Binding SetChatMixPresetCommand}"
                                    CommandParameter="-50"
                                    HorizontalAlignment="Stretch"
                                    Height="30"
                                    Padding="4,0"
                                    ToolTip.Tip="{Binding ChatMixTargetPresetTooltip}">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <theme:ThemeIcon Icon="{Binding ChatMixTargetIcon}" Width="10" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChatMixTargetChannelLabel}" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="sonar-btn"
                                    Command="{Binding SetChatMixPresetCommand}"
                                    CommandParameter="50"
                                    HorizontalAlignment="Stretch"
                                    Height="30"
                                    Padding="4,0"
                                    ToolTip.Tip="Bias toward Chat (+50%)">
                                <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <theme:ThemeIcon Icon="Telegram" Width="10" Height="10" VerticalAlignment="Center" />
                                    <TextBlock Text="CHAT" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Button Classes="sonar-btn"
                                Command="{Binding ResetChatMixCommand}"
                                HorizontalAlignment="Stretch"
                                Height="28">
                            <TextBlock Text="CENTER (50 / 50)" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Effective Game/Media vs. Chat Gain Readout (Matches Bottom Section of Master & Mic) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource TokenSurfaceRaised}"
                    BorderBrush="{DynamicResource TokenBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="12,10">
                <StackPanel Spacing="8">
                    <!-- Target (Game/Media) Effective Gain Bar -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding ChatMixTargetGainLabel}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TokenTextMuted}"
                                       LetterSpacing="0.5" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding GameMixPercentText}"
                                       FontSize="10"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TokenText}" />
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding GameMixPercent}"
                                     Height="4"
                                     MinWidth="20"
                                     CornerRadius="2"
                                     Background="{DynamicResource TokenSurfaceInset}"
                                     Foreground="{DynamicResource TokenAccent}" />
                    </StackPanel>

                    <!-- Chat Effective Gain Bar -->
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0"
                                       Text="CHAT GAIN"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TokenTextMuted}"
                                       LetterSpacing="0.5" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ChatMixPercentText}"
                                       FontSize="10"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TokenText}" />
                        </Grid>
                        <ProgressBar Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ChatMixPercent}"
                                     Height="4"
                                     MinWidth="20"
                                     CornerRadius="2"
                                     Background="{DynamicResource TokenSurfaceInset}"
                                     Foreground="{DynamicResource TokenAccent}" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
