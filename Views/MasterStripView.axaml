<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="using:TomatoMix.Theme"
             x:Class="TomatoMix.Views.MasterStripView">

    <Border Classes="channel-strip"
            Margin="0,0,5,0">
        <Grid RowDefinitions="Auto,*,Auto">

            <!-- Header -->
            <StackPanel Grid.Row="0">
                <Border Padding="12,10"
                        BorderBrush="{DynamicResource TokenBorder}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Border Width="24"
                                        Height="24"
                                        CornerRadius="6"
                                        Background="{DynamicResource TokenSurfaceInset}">
                                    <theme:ThemeIcon Icon="Layers"
                                                     Width="13"
                                                     Height="13"
                                                     Foreground="{DynamicResource TokenText}"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="MASTER"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.8"
                                           Foreground="{DynamicResource TokenText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource TokenSurfaceInset}"
                                    BorderBrush="{DynamicResource TokenBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <Ellipse Width="6"
                                             Height="6"
                                             Fill="{Binding MasterStatusBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="MAIN OUT"
                                               FontSize="9"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TokenTextMuted}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Global Endpoint Mix"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TokenTextMuted}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Responsive Vertical Fader + Live VU Meter Section -->
            <Border Grid.Row="1" Background="Transparent" Padding="12,10" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">

                    <!-- Digital Volume Readout Pill -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource TokenSurfaceInset}"
                            BorderBrush="{DynamicResource TokenBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,3"
                            HorizontalAlignment="Center"
                            MinWidth="76"
                            Margin="0,0,0,8">
                        <TextBlock Text="{Binding MasterVolumePercentText}"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TokenText}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- Flexible Fader + VU Meter Track (Scales with window height) -->
                    <Grid Grid.Row="1"
                          Background="Transparent"
                          ColumnDefinitions="*,Auto,Auto,*"
                          MinHeight="70"
                          MaxHeight="200"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          ClipToBounds="True">

                        <!-- dB Scale Labels -->
                        <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,4,8,4" HorizontalAlignment="Right">
                            <TextBlock Grid.Row="0" Text="100" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="75" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="2" Text="50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="3" Text="25" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                            <TextBlock Grid.Row="4" Text="0" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>

                        <!-- Vertical Fader Slider -->
                        <Slider Grid.Column="1"
                                Orientation="Vertical"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding MasterVolumePercent}"
                                VerticalAlignment="Stretch"
                                Foreground="{DynamicResource TokenAccent}"
                                HorizontalAlignment="Center" />

                        <!-- Responsive Live Vertical Peak VU Meter -->
                        <ProgressBar Grid.Column="2"
                                     Orientation="Vertical"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding MasterPeakLevel}"
                                     Width="10"
                                     MinWidth="10"
                                     MinHeight="40"
                                     Margin="10,4,0,4"
                                     CornerRadius="5"
                                     Background="{DynamicResource TokenSurfaceInset}"
                                     BorderBrush="{DynamicResource TokenBorder}"
                                     BorderThickness="1"
                                     Foreground="{DynamicResource TokenVuMeterGradient}"
                                     VerticalAlignment="Stretch" />
                    </Grid>

                    <!-- Master Mute & Clear Solo Buttons -->
                    <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                        <ToggleButton Classes="mute-toggle"
                                      IsChecked="{Binding IsMasterMuted}"
                                      HorizontalAlignment="Stretch"
                                      Height="30">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <theme:ThemeIcon Icon="Close" Width="11" Height="11" VerticalAlignment="Center" />
                                <TextBlock Text="MUTE MASTER" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <Button Classes="sonar-btn"
                                Command="{Binding ClearAllSolosCommand}"
                                HorizontalAlignment="Stretch"
                                Height="28">
                            <TextBlock Text="CLEAR ALL SOLOS" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Playback Hardware Selector (Under Master) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource TokenSurfaceRaised}"
                    BorderBrush="{DynamicResource TokenBorder}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,10,10"
                    Padding="12,10">
                <StackPanel Spacing="4">
                    <TextBlock Text="PLAYBACK HARDWARE"
                               FontSize="10"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TokenTextMuted}"
                               LetterSpacing="0.5" />
                    <ComboBox ItemsSource="{Binding OutputDevices}"
                              SelectedItem="{Binding SelectedDevice}"
                              HorizontalAlignment="Stretch"
                              Background="{DynamicResource TokenSurface}"
                              BorderBrush="{DynamicResource TokenBorder}"
                              Foreground="{DynamicResource TokenText}"
                              FontSize="11"
                              CornerRadius="6" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
