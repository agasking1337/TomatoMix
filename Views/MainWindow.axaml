<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TomatoMix.ViewModels"
        x:Class="TomatoMix.Views.MainWindow"
        x:Name="RootWindow"
        Title="TOMATOMIX // AUDIO MIXER"
        Icon="avares://TomatoMix/Assets/app.ico"
        Width="1380"
        Height="860"
        MinWidth="1060"
        MinHeight="720"
        Background="#0B0D12"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Crisp Vector SVG Geometries (24x24 ViewBox) -->
        <StreamGeometry x:Key="SvgLogoSliders">M3,17 V19 H9 V17 H3 Z M3,5 V7 H13 V5 H3 Z M13,21 V19 H21 V17 H13 V15 H11 V21 H13 Z M7,9 V11 H3 V13 H7 V15 H9 V9 H7 Z M21,13 V11 H11 V13 H21 Z M15,9 H17 V7 H21 V5 H17 V3 H15 V9 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgSpeaker">M3,9 V15 H7 L12,20 V4 L7,9 H3 Z M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V16.02 C15.48,15.29 16.5,13.77 16.5,12 Z M14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 C19,15.17 16.89,17.85 14,18.71 V20.77 C18.01,19.86 21,16.28 21,12 C21,7.72 18.01,4.14 14,3.23 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgSpeakerMute">M16.5,12 C16.5,10.23 15.48,8.71 14,7.97 V10.18 L16.45,12.63 C16.48,12.43 16.5,12.22 16.5,12 Z M19,12 C19,12.94 18.8,13.82 18.46,14.64 L19.97,16.15 C20.63,14.91 21,13.5 21,12 C21,7.72 18.01,4.14 14,3.23 V5.29 C16.89,6.15 19,8.83 19,12 Z M4.27,3 L3,4.27 L7.73,9 H3 V15 H7 L12,20 V13.27 L16.25,17.52 C15.58,18.04 14.83,18.45 14,18.7 V20.76 C15.38,20.45 16.63,19.81 17.69,18.95 L19.73,21 L21,19.73 L12,10.73 L4.27,3 Z M12,4 L9.91,6.09 L12,8.18 V4 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgGamepad">M6,9 H8 V11 H10 V13 H8 V15 H6 V13 H4 V11 H6 Z M15.5,10.5 A1,1 0 1,0 15.5,12.5 A1,1 0 1,0 15.5,10.5 Z M18,12.5 A1,1 0 1,0 18,14.5 A1,1 0 1,0 18,12.5 Z M6,6 H18 A5,5 0 0,1 23,11 V14 A4,4 0 0,1 19,18 C17.5,18 16.3,17.2 15.3,16 H8.7 C7.7,17.2 6.5,18 5,18 A4,4 0 0,1 1,14 V11 A5,5 0 0,1 6,6 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgMic">M12,2 A3,3 0 0,1 15,5 V11 A3,3 0 0,1 9,11 V5 A3,3 0 0,1 12,2 Z M19,10 V11 A7,7 0 0,1 13,17.92 V20 H16 V22 H8 V20 H11 V17.92 A7,7 0 0,1 5,11 V10 H7 V11 A5,5 0 0,0 17,11 V10 H19 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgRefresh">M17.65,6.35 C16.2,4.9 14.21,4 12,4 A8,8 0 0,0 4,12 A8,8 0 0,0 12,20 C15.73,20 18.84,17.45 19.73,14 H17.65 C16.83,16.33 14.61,18 12,18 A6,6 0 0,1 6,12 A6,6 0 0,1 12,6 C13.66,6 15.14,6.69 16.22,7.78 L13,11 H20 V4 L17.65,6.35 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgPlus">M19,13 H13 V19 H11 V13 H5 V11 H11 V5 H13 V11 H19 V13 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgEdit">M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgClose">M19,6.41 L17.59,5 L12,10.59 L6.41,5 L5,6.41 L10.59,12 L5,17.59 L6.41,19 L12,13.41 L17.59,19 L19,17.59 L13.41,12 L19,6.41 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgSwap">M6.99,11 L3,15 L6.99,19 V16 H14 V14 H6.99 V11 Z M21,9 L17.01,5 V8 H10 V10 H17.01 V13 L21,9 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgDownloadDrop">M19,9 H15 V3 H9 V9 H5 L12,16 L19,9 Z M5,18 V20 H19 V18 H5 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgEqualizerWave">M3,17 H5 V7 H3 V17 Z M7,21 H9 V3 H7 V21 Z M11,15 H13 V9 H11 V15 Z M15,19 H17 V5 H15 V19 Z M19,14 H21 V10 H19 V14 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgSave">M17,3 H5 C3.89,3 3,3.9 3,5 V19 C3,20.1 3.89,21 5,21 H19 C20.1,21 21,20.1 21,19 V7 L17,3 Z M12,19 C10.34,19 9,17.66 9,16 C9,14.34 10.34,13 12,13 C13.66,13 15,14.34 15,16 C15,17.66 13.66,19 12,19 Z M15,9 H5 V5 H15 V9 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgTrash">M6,19 C6,20.1 6.9,21 8,21 H16 C17.1,21 18,20.1 18,19 V7 H6 V19 Z M19,4 H15.5 L14.5,3 H9.5 L8.5,4 H5 V6 H19 V4 Z</StreamGeometry>
        <StreamGeometry x:Key="SvgFolder">M10,4 H4 C2.9,4 2.01,4.9 2.01,6 L2,18 C2,19.1 2.9,20 4,20 H20 C21.1,20 22,19.1 22,18 V8 C22,6.9 21.1,6 20,6 H12 L10,4 Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <!-- Unified Dark Mixer Button Style -->
        <Style Selector="Button.sonar-btn">
            <Setter Property="Background" Value="#1C202B" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="BorderBrush" Value="#2D3343" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sonar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#262C3A" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4B5563" />
        </Style>

        <!-- Mute Toggle Button Style -->
        <Style Selector="ToggleButton.mute-toggle">
            <Setter Property="Background" Value="#1B1F2A" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#2B3142" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.mute-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#3B1219" />
            <Setter Property="Foreground" Value="#FF4D6D" />
            <Setter Property="BorderBrush" Value="#FF3355" />
        </Style>

        <!-- Solo Toggle Button Style -->
        <Style Selector="ToggleButton.solo-toggle">
            <Setter Property="Background" Value="#1B1F2A" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="BorderBrush" Value="#2B3142" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.solo-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#3B2E0D" />
            <Setter Property="Foreground" Value="#FACC15" />
            <Setter Property="BorderBrush" Value="#EAB308" />
        </Style>

        <!-- Channel Card Style -->
        <Style Selector="Border.channel-strip">
            <Setter Property="Background" Value="#13161F" />
            <Setter Property="BorderBrush" Value="#212634" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>

        <!-- App Session Card Style -->
        <Style Selector="Border.app-card">
            <Setter Property="Background" Value="#191D28" />
            <Setter Property="BorderBrush" Value="#262C3D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.app-card:pointerover">
            <Setter Property="Background" Value="#202534" />
            <Setter Property="BorderBrush" Value="#38415A" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ==================== TOP NAVIGATION & HEADER BAR ==================== -->
        <Border Grid.Row="0"
                Background="#10131B"
                BorderBrush="#1E2330"
                BorderThickness="0,0,0,1"
                Padding="22,12">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#FF5500">
                        <PathIcon Data="{StaticResource SvgLogoSliders}"
                                  Width="18"
                                  Height="18"
                                  Foreground="#FFFFFF"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="TOMATOMIX"
                                       FontSize="17"
                                       FontWeight="Black"
                                       LetterSpacing="1.5"
                                       Foreground="#F8FAFC"
                                       VerticalAlignment="Center" />
                            <Border Background="#26FF5500"
                                    BorderBrush="#FF5500"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="7,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AUDIO MIXER"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           LetterSpacing="1"
                                           Foreground="#FF6E26"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="MULTI-CHANNEL APPLICATION AUDIO ROUTER &amp; EQUALIZER"
                                   FontSize="10"
                                   Foreground="#64748B"
                                   LetterSpacing="0.8" />
                    </StackPanel>
                </StackPanel>

                <!-- Center ChatMix Dial / Balance Bar -->
                <Border Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#161A25"
                        BorderBrush="#252B3B"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,6"
                        Margin="20,0">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <TextBlock Text="CHATMIX"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="#94A3B8"
                                   LetterSpacing="1"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource SvgGamepad}"
                                      Width="13"
                                      Height="13"
                                      Foreground="#00E5FF"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="GAME"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#00E5FF"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Slider Width="160"
                                Minimum="-100"
                                Maximum="100"
                                Value="{Binding ChatMixBalance}"
                                Foreground="#A855F7"
                                VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource SvgMic}"
                                      Width="13"
                                      Height="13"
                                      Foreground="#A855F7"
                                      VerticalAlignment="Center" />
                            <TextBlock Text="CHAT"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#A855F7"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Border Background="#1E2331"
                                CornerRadius="4"
                                Padding="8,4"
                                MinWidth="86"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding ChatMixLabelText}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#E2E8F0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <Button Classes="sonar-btn"
                                Content="CENTER"
                                Command="{Binding ResetChatMixCommand}"
                                Height="26"
                                Padding="10,0"
                                FontSize="10"
                                VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Right Actions: Rescan + Add Custom Channel -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="sonar-btn"
                            Command="{Binding RefreshDevicesAndSessionsCommand}"
                            ToolTip.Tip="Rescan Audio Sessions &amp; Hardware"
                            Height="34"
                            Padding="12,0">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource SvgRefresh}" Width="13" Height="13" Foreground="#CBD5E1" VerticalAlignment="Center" />
                            <TextBlock Text="RESCAN" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenAddChannelPopupCommand}"
                            Background="#FF5500"
                            Foreground="#FFFFFF"
                            BorderThickness="0"
                            CornerRadius="7"
                            Height="34"
                            Padding="14,0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource SvgPlus}" Width="13" Height="13" Foreground="#FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="ADD CHANNEL" FontSize="11" FontWeight="ExtraBold" LetterSpacing="0.8" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ==================== MAIN MIXER WORKSPACE (RESPONSIVE FULL-SCREEN EXPANSION) ==================== -->
        <Grid Grid.Row="1" Margin="18,14,18,10">
            <Grid ColumnDefinitions="240,*,240">

                <!-- 1. MASTER CHANNEL STRIP (Pinned Left with Playback Hardware Selector Underneath) -->
                <Border Grid.Column="0"
                        Classes="channel-strip"
                        Background="#12151E"
                        BorderBrush="#2A3042"
                        Margin="0,0,12,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Top Orange Accent Bar & Header -->
                        <StackPanel Grid.Row="0">
                            <Border Height="4" CornerRadius="10,10,0,0" Background="#FF5500" />
                            <Border Padding="14,12" BorderBrush="#1E2330" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="6" Background="#26FF5500">
                                                <PathIcon Data="{StaticResource SvgSpeaker}"
                                                          Width="14"
                                                          Height="14"
                                                          Foreground="#FF5500"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="MASTER"
                                                       FontSize="14"
                                                       FontWeight="Black"
                                                       LetterSpacing="1.2"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Background="#26FF5500"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="MAIN OUT"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#FF6E26"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Global Endpoint Mix"
                                               FontSize="11"
                                               Foreground="#64748B" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Vertical Fader + Dual Live VU Meter Section -->
                        <Border Grid.Row="1" Padding="14,12">
                            <Grid RowDefinitions="Auto,*,Auto">

                                <!-- Digital Volume Readout Pill -->
                                <Border Grid.Row="0"
                                        Background="#0B0D13"
                                        BorderBrush="#252B3B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        MinWidth="92"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="{Binding MasterVolumePercentText}"
                                               FontSize="15"
                                               FontWeight="Black"
                                               Foreground="#FF5500"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Fader + VU Meter Track -->
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto,*"
                                      Height="190"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">

                                    <!-- dB Scale Labels -->
                                    <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,6,8,6" HorizontalAlignment="Right">
                                        <TextBlock Grid.Row="0" Text="100" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="75" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="2" Text="50" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="3" Text="25" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="4" Text="0" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Vertical Fader Slider -->
                                    <Slider Grid.Column="1"
                                            Orientation="Vertical"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding MasterVolumePercent}"
                                            Height="185"
                                            Foreground="#FF5500"
                                            HorizontalAlignment="Center" />

                                    <!-- Live Vertical Peak VU Meter -->
                                    <Border Grid.Column="2"
                                            Width="12"
                                            Height="180"
                                            CornerRadius="6"
                                            Background="#0A0C10"
                                            BorderBrush="#1F2433"
                                            BorderThickness="1"
                                            Margin="12,0,0,0"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Border Width="10"
                                                Height="{Binding MasterPeakBarHeight}"
                                                CornerRadius="5"
                                                VerticalAlignment="Bottom">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0%,100%" EndPoint="0%,0%">
                                                    <GradientStop Offset="0.0" Color="#10B981" />
                                                    <GradientStop Offset="0.65" Color="#F59E0B" />
                                                    <GradientStop Offset="1.0" Color="#FF5500" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                    </Border>
                                </Grid>

                                <!-- Master Mute & Clear Solo Buttons -->
                                <StackPanel Grid.Row="2" Spacing="8" Margin="0,10,0,0">
                                    <ToggleButton Classes="mute-toggle"
                                                  IsChecked="{Binding IsMasterMuted}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="34">
                                        <StackPanel Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource SvgSpeakerMute}" Width="13" Height="13" VerticalAlignment="Center" />
                                            <TextBlock Text="MUTE MASTER" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding ClearAllSolosCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="32">
                                        <TextBlock Text="CLEAR ALL SOLOS" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Playback Hardware Selector & Routing Matrix (Under Master) -->
                        <Border Grid.Row="2"
                                Background="#0E1118"
                                BorderBrush="#1E2330"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="14,14">
                            <StackPanel Spacing="12">
                                <!-- Playback Hardware Dropdown -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="PLAYBACK HARDWARE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#94A3B8"
                                               LetterSpacing="0.8" />
                                    <ComboBox ItemsSource="{Binding OutputDevices}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              HorizontalAlignment="Stretch"
                                              Background="#171B26"
                                              BorderBrush="#293042"
                                              Foreground="#F1F5F9"
                                              FontSize="11"
                                              CornerRadius="6" />
                                </StackPanel>

                                <Border Height="1" Background="#1B202E" />

                                <!-- Routing Matrix Summary -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="ROUTING MATRIX"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               LetterSpacing="0.8"
                                               Foreground="#64748B" />
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalRoutedAppsCount}"
                                                   FontSize="18"
                                                   FontWeight="Black"
                                                   Foreground="#F8FAFC"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="ACTIVE AUDIO APPS"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="Drag &amp; drop app cards between channels or click the route button."
                                               FontSize="10"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- 2. CHANNELS GRID (EXPANDS PROPORTIONALLY TO FILL FULL SCREEN) -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Channels}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ChannelViewModel">
                            <Border Classes="channel-strip"
                                    Margin="6,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    DragDrop.AllowDrop="True">
                                <Grid RowDefinitions="Auto,Auto,*">

                                    <!-- A. CHANNEL HEADER BAR -->
                                    <StackPanel Grid.Row="0">
                                        <!-- Top Colored Neon Strip -->
                                        <Border Height="4"
                                                CornerRadius="10,10,0,0"
                                                Background="{Binding AccentBrush}" />

                                        <Border Padding="14,12"
                                                BorderBrush="#1E2330"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <!-- Channel SVG Icon + Name / Rename TextBox -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Width="26"
                                                            Height="26"
                                                            CornerRadius="6"
                                                            Background="{Binding AccentGlowBrush}">
                                                        <PathIcon Data="{Binding ChannelIconGeometry}"
                                                                  Width="14"
                                                                  Height="14"
                                                                  Foreground="{Binding AccentBrush}"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                    </Border>

                                                    <TextBlock Text="{Binding Name}"
                                                               IsVisible="{Binding !IsEditingName}"
                                                               FontSize="14"
                                                               FontWeight="Black"
                                                               LetterSpacing="1.1"
                                                               Foreground="#F8FAFC"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <TextBox Text="{Binding Name}"
                                                             IsVisible="{Binding IsEditingName}"
                                                             MinWidth="95"
                                                             FontSize="12"
                                                             FontWeight="Bold"
                                                             Padding="6,3"
                                                             VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Rename / Delete Controls -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Classes="sonar-btn"
                                                            Command="{Binding ToggleEditNameCommand}"
                                                            ToolTip.Tip="Rename Channel"
                                                            Width="26"
                                                            Height="26"
                                                            Padding="0">
                                                        <PathIcon Data="{StaticResource SvgEdit}" Width="11" Height="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Classes="sonar-btn"
                                                            IsVisible="{Binding CanDelete}"
                                                            Command="{Binding DeleteChannelCommand}"
                                                            ToolTip.Tip="Delete Custom Channel"
                                                            Width="26"
                                                            Height="26"
                                                            Padding="0">
                                                        <PathIcon Data="{StaticResource SvgClose}" Width="11" Height="11" Foreground="#FF4D6D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- B. VERTICAL FADER + LIVE PEAK METER + MUTE/SOLO + MINI EQ -->
                                    <Border Grid.Row="1"
                                            Padding="14,12"
                                            BorderBrush="#1E2330"
                                            BorderThickness="0,0,0,1">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                            <!-- Volume Readout Pill -->
                                            <Border Grid.Row="0"
                                                    Background="#0B0D13"
                                                    BorderBrush="#23293A"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,4"
                                                    HorizontalAlignment="Center"
                                                    MinWidth="86"
                                                    Margin="0,0,0,10">
                                                <TextBlock Text="{Binding VolumePercentText}"
                                                           FontSize="15"
                                                           FontWeight="Black"
                                                           Foreground="{Binding AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Vertical Slider + Peak Bar -->
                                            <Grid Grid.Row="1"
                                                  ColumnDefinitions="*,Auto,Auto,*"
                                                  Height="190"
                                                  HorizontalAlignment="Center">

                                                <!-- Tick Marks -->
                                                <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,6,8,6">
                                                    <TextBlock Grid.Row="0" Text="100" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="1" Text="75" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="2" Text="50" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="3" Text="25" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="4" Text="0" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>

                                                <!-- Channel Volume Fader -->
                                                <Slider Grid.Column="1"
                                                        Orientation="Vertical"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding VolumePercent}"
                                                        Height="185"
                                                        Foreground="{Binding AccentBrush}"
                                                        HorizontalAlignment="Center" />

                                                <!-- Live Channel VU Meter -->
                                                <Border Grid.Column="2"
                                                        Width="12"
                                                        Height="180"
                                                        CornerRadius="6"
                                                        Background="#0A0C10"
                                                        BorderBrush="#1F2433"
                                                        BorderThickness="1"
                                                        Margin="12,0,0,0"
                                                        ClipToBounds="True"
                                                        VerticalAlignment="Center">
                                                    <Border Width="10"
                                                            Height="{Binding PeakBarHeight}"
                                                            CornerRadius="5"
                                                            Background="{Binding AccentBrush}"
                                                            VerticalAlignment="Bottom" />
                                                </Border>
                                            </Grid>

                                            <!-- MUTE & SOLO Buttons -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*,8,*" Margin="0,10,0,0">
                                                <ToggleButton Grid.Column="0"
                                                              Classes="mute-toggle"
                                                              IsChecked="{Binding IsMuted}"
                                                              HorizontalAlignment="Stretch"
                                                              Height="32">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource SvgSpeakerMute}" Width="12" Height="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="MUTE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton Grid.Column="2"
                                                              Classes="solo-toggle"
                                                              IsChecked="{Binding IsSolo}"
                                                              HorizontalAlignment="Stretch"
                                                              Height="32">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="S" FontSize="11" FontWeight="Black" VerticalAlignment="Center" />
                                                        <TextBlock Text="SOLO" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- PER-CHANNEL MINI EQ PREVIEW & STUDIO BUTTON -->
                                            <Border Grid.Row="3"
                                                    Margin="0,10,0,0"
                                                    Background="#0B0D13"
                                                    BorderBrush="#22283A"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="8,6">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                        <ToggleButton Grid.Column="0"
                                                                      IsChecked="{Binding IsEqEnabled}"
                                                                      Width="34"
                                                                      Height="22"
                                                                      Padding="0"
                                                                      CornerRadius="4"
                                                                      FontSize="9"
                                                                      FontWeight="Black"
                                                                      HorizontalContentAlignment="Center"
                                                                      VerticalContentAlignment="Center"
                                                                      Content="EQ"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip.Tip="Enable / Bypass Channel Equalizer" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding EqStatusBadgeText}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#CBD5E1"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding ActiveEqProfileName}" />

                                                        <Button Grid.Column="2"
                                                                Classes="sonar-btn"
                                                                Command="{Binding OpenEqEditorCommand}"
                                                                Height="22"
                                                                Padding="8,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="Open 10-Band EQ &amp; Profile Saver">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <PathIcon Data="{StaticResource SvgEqualizerWave}" Width="10" Height="10" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                                <TextBlock Text="EQ" FontSize="9" FontWeight="ExtraBold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Mini Live Frequency Response Curve -->
                                                    <Button Command="{Binding OpenEqEditorCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch">
                                                        <Viewbox Stretch="Fill" Height="36">
                                                            <Canvas Width="220" Height="36" ClipToBounds="True">
                                                                <Line StartPoint="0,18" EndPoint="220,18" Stroke="#1E2436" StrokeThickness="1" />
                                                                <Polygon Points="{Binding MiniEqFillPoints}"
                                                                         Fill="{Binding AccentGlowBrush}" />
                                                                <Polyline Points="{Binding MiniEqCurvePoints}"
                                                                          Stroke="{Binding AccentBrush}"
                                                                          StrokeThickness="1.8" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                        </Grid>
                                    </Border>

                                    <!-- C. ROUTED APPLICATIONS SECTION -->
                                    <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="12,10,12,12">
                                        <!-- Section Header -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,8">
                                            <TextBlock Text="ROUTED APPS"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       LetterSpacing="1"
                                                       Foreground="#64748B"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Background="#1D2230"
                                                    CornerRadius="10"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppCount}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="#CBD5E1"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Scrollable App Cards List + Empty Drop Zone -->
                                        <Grid Grid.Row="1">
                                            <!-- Empty Drop Placeholder -->
                                            <Border IsVisible="{Binding HasNoApps}"
                                                    BorderBrush="#222838"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Background="#0E1118"
                                                    Padding="14">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                                    <PathIcon Data="{StaticResource SvgDownloadDrop}"
                                                              Width="18"
                                                              Height="18"
                                                              Foreground="#475569"
                                                              HorizontalAlignment="Center" />
                                                    <TextBlock Text="DROP APPS HERE"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               LetterSpacing="0.8"
                                                               Foreground="#475569"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="Drag an app card from another channel to route its audio here"
                                                               FontSize="10"
                                                               Foreground="#334155"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Routed App Cards -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Apps}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="8" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:AppSessionViewModel">
                                                            <Border Classes="app-card"
                                                                    Padding="10,8"
                                                                    PointerPressed="OnAppCardPointerPressed">
                                                                <StackPanel Spacing="6">

                                                                    <!-- Row 1: App Icon + Name + Mute + Move Channel Menu -->
                                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                                                        <!-- App Icon or Initials -->
                                                                        <Grid Grid.Column="0" Width="24" Height="24" Margin="0,0,8,0" VerticalAlignment="Center">
                                                                            <Border CornerRadius="5"
                                                                                    Background="#252C3D"
                                                                                    IsVisible="{Binding AppIcon, Converter={x:Static ObjectConverters.IsNull}}">
                                                                                <TextBlock Text="{Binding Initials}"
                                                                                           FontSize="10"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="#E2E8F0"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <Image Source="{Binding AppIcon}"
                                                                                   Width="22"
                                                                                   Height="22"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding AppIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                        </Grid>

                                                                        <!-- App Display Name -->
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding DisplayName}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#F1F5F9"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding DisplayName}" />

                                                                        <!-- App Trim Mute Toggle -->
                                                                        <ToggleButton Grid.Column="2"
                                                                                      Classes="mute-toggle"
                                                                                      IsChecked="{Binding IsMuted}"
                                                                                      Width="26"
                                                                                      Height="24"
                                                                                      Padding="0"
                                                                                      Margin="4,0,4,0"
                                                                                      VerticalAlignment="Center"
                                                                                      ToolTip.Tip="Mute Application">
                                                                            <PathIcon Data="{StaticResource SvgSpeakerMute}" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </ToggleButton>

                                                                        <!-- Route App to Another Channel Button -->
                                                                        <Button Grid.Column="3"
                                                                                Classes="sonar-btn"
                                                                                Width="26"
                                                                                Height="24"
                                                                                Padding="0"
                                                                                VerticalAlignment="Center"
                                                                                Click="OnRouteAppButtonClick"
                                                                                ToolTip.Tip="Move App to Another Channel">
                                                                            <PathIcon Data="{StaticResource SvgSwap}" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- Row 2: App Trim Slider + Percentage -->
                                                                    <Grid ColumnDefinitions="*,42" VerticalAlignment="Center">
                                                                        <Slider Grid.Column="0"
                                                                                Minimum="0"
                                                                                Maximum="100"
                                                                                Value="{Binding RelativeVolume}"
                                                                                Foreground="{Binding AccentBrush}"
                                                                                VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="1"
                                                                                   Text="{Binding VolumePercentText}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="#94A3B8"
                                                                                   HorizontalAlignment="Right"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>

                                                                    <!-- Row 3: Live Mini Audio Meter Bar -->
                                                                    <ProgressBar Minimum="0"
                                                                                 Maximum="100"
                                                                                 Value="{Binding PeakLevel}"
                                                                                 Height="3"
                                                                                 CornerRadius="2"
                                                                                 Background="#0D1017"
                                                                                 Foreground="{Binding AccentBrush}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. DEDICATED MIC CHANNEL STRIP (Pinned Right with Capture Hardware Selector Underneath) -->
                <Border Grid.Column="2"
                        Classes="channel-strip"
                        Background="#12151E"
                        BorderBrush="#2A3042"
                        Margin="12,0,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Top Emerald Accent Bar & Header -->
                        <StackPanel Grid.Row="0">
                            <Border Height="4" CornerRadius="10,10,0,0" Background="#10B981" />
                            <Border Padding="14,12" BorderBrush="#1E2330" BorderThickness="0,0,0,1">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="26" Height="26" CornerRadius="6" Background="#2610B981">
                                                <PathIcon Data="{StaticResource SvgMic}"
                                                          Width="14"
                                                          Height="14"
                                                          Foreground="#10B981"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="MIC"
                                                       FontSize="14"
                                                       FontWeight="Black"
                                                       LetterSpacing="1.2"
                                                       Foreground="#FFFFFF"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Background="#2610B981"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="CAPTURE IN"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#10B981"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Microphone Input &amp; Voice DSP"
                                               FontSize="11"
                                               Foreground="#64748B" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Vertical Mic Gain Fader + VU Meter + Mute/Listen + Mini EQ -->
                        <Border Grid.Row="1" Padding="14,12" BorderBrush="#1E2330" BorderThickness="0,0,0,1">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                                <!-- Digital Mic Gain Readout Pill -->
                                <Border Grid.Row="0"
                                        Background="#0B0D13"
                                        BorderBrush="#252B3B"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,4"
                                        HorizontalAlignment="Center"
                                        MinWidth="92"
                                        Margin="0,0,0,10">
                                    <TextBlock Text="{Binding MicChannel.VolumePercentText}"
                                               FontSize="15"
                                               FontWeight="Black"
                                               Foreground="#10B981"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Fader + VU Meter Track -->
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto,*"
                                      Height="190"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center">

                                    <!-- dB Scale Labels -->
                                    <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,6,8,6" HorizontalAlignment="Right">
                                        <TextBlock Grid.Row="0" Text="100" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="75" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="2" Text="50" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="3" Text="25" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="4" Text="0" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Vertical Mic Gain Slider -->
                                    <Slider Grid.Column="1"
                                            Orientation="Vertical"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding MicChannel.VolumePercent}"
                                            Height="185"
                                            Foreground="#10B981"
                                            HorizontalAlignment="Center" />

                                    <!-- Live Vertical Mic Peak VU Meter -->
                                    <Border Grid.Column="2"
                                            Width="12"
                                            Height="180"
                                            CornerRadius="6"
                                            Background="#0A0C10"
                                            BorderBrush="#1F2433"
                                            BorderThickness="1"
                                            Margin="12,0,0,0"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Border Width="10"
                                                Height="{Binding MicChannel.PeakBarHeight}"
                                                CornerRadius="5"
                                                Background="#10B981"
                                                VerticalAlignment="Bottom" />
                                    </Border>
                                </Grid>

                                <!-- Mic MUTE & LISTEN (Sidetone) Buttons -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,8,*" Margin="0,10,0,0">
                                    <ToggleButton Grid.Column="0"
                                                  Classes="mute-toggle"
                                                  IsChecked="{Binding MicChannel.IsMuted}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="32">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource SvgSpeakerMute}" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="MUTE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <ToggleButton Grid.Column="2"
                                                  Classes="solo-toggle"
                                                  IsChecked="{Binding IsMicMonitoring}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="32"
                                                  ToolTip.Tip="Listen to your Microphone in real time with the 10-band Mic EQ applied (Sidetone)">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource SvgSpeaker}" Width="12" Height="12" VerticalAlignment="Center" />
                                            <TextBlock Text="LISTEN" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>

                                <!-- MIC MINI EQ PREVIEW & STUDIO BUTTON -->
                                <Border Grid.Row="3"
                                        Margin="0,10,0,0"
                                        Background="#0B0D13"
                                        BorderBrush="#22283A"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="8,6">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <ToggleButton Grid.Column="0"
                                                          IsChecked="{Binding MicChannel.IsEqEnabled}"
                                                          Width="34"
                                                          Height="22"
                                                          Padding="0"
                                                          CornerRadius="4"
                                                          FontSize="9"
                                                          FontWeight="Black"
                                                          HorizontalContentAlignment="Center"
                                                          VerticalContentAlignment="Center"
                                                          Content="EQ"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="Enable / Bypass Microphone Equalizer" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MicChannel.EqStatusBadgeText}"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="#CBD5E1"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="6,0"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding MicChannel.ActiveEqProfileName}" />

                                            <Button Grid.Column="2"
                                                    Classes="sonar-btn"
                                                    Command="{Binding OpenMicEqStudioCommand}"
                                                    Height="22"
                                                    Padding="8,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Open 10-Band Microphone Equalizer">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <PathIcon Data="{StaticResource SvgEqualizerWave}" Width="10" Height="10" Foreground="#10B981" VerticalAlignment="Center" />
                                                    <TextBlock Text="EQ" FontSize="9" FontWeight="ExtraBold" Foreground="#10B981" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Mini Live Mic Frequency Response Curve -->
                                        <Button Command="{Binding OpenMicEqStudioCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                            <Viewbox Stretch="Fill" Height="36">
                                                <Canvas Width="220" Height="36" ClipToBounds="True">
                                                    <Line StartPoint="0,18" EndPoint="220,18" Stroke="#1E2436" StrokeThickness="1" />
                                                    <Polygon Points="{Binding MicChannel.MiniEqFillPoints}"
                                                             Fill="{Binding MicChannel.AccentGlowBrush}" />
                                                    <Polyline Points="{Binding MicChannel.MiniEqCurvePoints}"
                                                              Stroke="#10B981"
                                                              StrokeThickness="1.8" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- Microphone Hardware Selector (Under Mic Strip) -->
                        <Border Grid.Row="2"
                                Background="#0E1118"
                                BorderBrush="#1E2330"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="14,14">
                            <StackPanel Spacing="12">
                                <!-- Mic Input Hardware Dropdown -->
                                <StackPanel Spacing="6">
                                    <TextBlock Text="MIC INPUT HARDWARE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="#94A3B8"
                                               LetterSpacing="0.8" />
                                    <ComboBox ItemsSource="{Binding InputDevices}"
                                              SelectedItem="{Binding SelectedMicDevice}"
                                              HorizontalAlignment="Stretch"
                                              Background="#171B26"
                                              BorderBrush="#293042"
                                              Foreground="#F1F5F9"
                                              FontSize="11"
                                              CornerRadius="6" />
                                </StackPanel>

                                <Border Height="1" Background="#1B202E" />

                                <!-- Mic Sidetone / Voice DSP Status -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="VOICE CAPTURE ENGINE"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               LetterSpacing="0.8"
                                               Foreground="#64748B" />
                                    <TextBlock Text="Controls Windows WASAPI Microphone gain &amp; mute. Toggle LISTEN to monitor your voice with live 10-band EQ."
                                               FontSize="10"
                                               Foreground="#64748B"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

            </Grid>

            <!-- ==================== ADD CUSTOM CHANNEL MODAL OVERLAY ==================== -->
            <Border IsVisible="{Binding IsAddChannelPopupOpen}"
                    Background="#B306080C"
                    CornerRadius="10">
                <Border Width="380"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#151924"
                        BorderBrush="#2D3548"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CREATE CUSTOM CHANNEL"
                                       FontSize="15"
                                       FontWeight="Black"
                                       LetterSpacing="1"
                                       Foreground="#F8FAFC" />
                            <TextBlock Text="Add a new logical audio group to your mixer."
                                       FontSize="12"
                                       Foreground="#94A3B8" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="CHANNEL NAME"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="0.8"
                                       Foreground="#94A3B8" />
                            <TextBox Text="{Binding NewChannelName}"
                                     Watermark="e.g. BROWSER, MUSIC, STREAM"
                                     Background="#0E1118"
                                     BorderBrush="#293042"
                                     Foreground="#FFFFFF"
                                     FontSize="13"
                                     Padding="10,8"
                                     CornerRadius="6" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="CHANNEL ACCENT COLOR"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="0.8"
                                       Foreground="#94A3B8" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Command="{Binding SelectNewChannelColorCommand}" CommandParameter="#10B981" Width="32" Height="32" CornerRadius="16" Background="#10B981" />
                                <Button Command="{Binding SelectNewChannelColorCommand}" CommandParameter="#3B82F6" Width="32" Height="32" CornerRadius="16" Background="#3B82F6" />
                                <Button Command="{Binding SelectNewChannelColorCommand}" CommandParameter="#F97316" Width="32" Height="32" CornerRadius="16" Background="#F97316" />
                                <Button Command="{Binding SelectNewChannelColorCommand}" CommandParameter="#EAB308" Width="32" Height="32" CornerRadius="16" Background="#EAB308" />
                                <Button Command="{Binding SelectNewChannelColorCommand}" CommandParameter="#EF4444" Width="32" Height="32" CornerRadius="16" Background="#EF4444" />
                                <Button Command="{Binding SelectNewChannelColorCommand}" CommandParameter="#14B8A6" Width="32" Height="32" CornerRadius="16" Background="#14B8A6" />
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,10,*" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Classes="sonar-btn"
                                    Content="CANCEL"
                                    Command="{Binding CancelAddChannelCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="36" />
                            <Button Grid.Column="2"
                                    Content="CREATE CHANNEL"
                                    Command="{Binding ConfirmAddChannelCommand}"
                                    Background="#FF5500"
                                    Foreground="#FFFFFF"
                                    FontWeight="Bold"
                                    FontSize="11"
                                    CornerRadius="6"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Height="36" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ==================== 10-BAND PARAMETRIC EQ & PROFILE SAVER MODAL ==================== -->
            <Border IsVisible="{Binding IsEqEditorOpen}"
                    Background="#D906080D"
                    CornerRadius="10">
                <Border Width="940"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="#121621"
                        BorderBrush="#2A3246"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                        <!-- 1. EQ Header Bar + Channel Switcher Tabs -->
                        <Border Grid.Row="0"
                                Background="#161B28"
                                BorderBrush="#242B3D"
                                BorderThickness="0,0,0,1"
                                Padding="20,14">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <!-- Title & Active Channel Badge -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Border Width="8"
                                            Height="28"
                                            CornerRadius="4"
                                            Background="{Binding EqTargetChannel.AccentBrush}" />
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="10-BAND CHANNEL EQUALIZER"
                                                       FontSize="14"
                                                       FontWeight="Black"
                                                       LetterSpacing="1.2"
                                                       Foreground="#F8FAFC"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{Binding EqTargetChannel.AccentGlowBrush}"
                                                    BorderBrush="{Binding EqTargetChannel.AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EqTargetChannel.Name}"
                                                           FontSize="10"
                                                           FontWeight="Black"
                                                           Foreground="{Binding EqTargetChannel.AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Customize per-channel frequency curve, preamp headroom, and save reusable EQ profiles"
                                                   FontSize="11"
                                                   Foreground="#64748B" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Quick Channel Switcher Pills -->
                                <ItemsControl Grid.Column="1"
                                              ItemsSource="{Binding Channels}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="16,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ChannelViewModel">
                                            <Button Classes="sonar-btn"
                                                    Command="{Binding OpenEqEditorCommand}"
                                                    Height="30"
                                                    Padding="10,0">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <PathIcon Data="{Binding ChannelIconGeometry}" Width="12" Height="12" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold" Foreground="{Binding AccentBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Enable Toggle, Live Audition Loop, APO Hook & Close Button -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ToggleButton IsChecked="{Binding IsAuditioningEq}"
                                                  Background="#1D283A"
                                                  Foreground="#38BDF8"
                                                  BorderBrush="#0284C7"
                                                  BorderThickness="1"
                                                  CornerRadius="6"
                                                  Height="30"
                                                  Padding="10,0"
                                                  FontWeight="Bold"
                                                  FontSize="10"
                                                  Cursor="Hand"
                                                  VerticalContentAlignment="Center"
                                                  ToolTip.Tip="Play built-in full-spectrum test synth loop through the live C# 10-Band Biquad DSP engine to immediately hear EQ changes">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource SvgSpeaker}" Width="12" Height="12" Foreground="#38BDF8" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AuditionButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding OpenOrInstallEqualizerApoCommand}"
                                            Height="30"
                                            Padding="10,0"
                                            ToolTip.Tip="{Binding ApoStatusText}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="#10B981" IsVisible="{Binding IsApoInstalled}" VerticalAlignment="Center" />
                                            <Ellipse Width="7" Height="7" Fill="#F59E0B" IsVisible="{Binding !IsApoInstalled}" VerticalAlignment="Center" />
                                            <TextBlock Text="APO HOOK" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <ToggleButton IsChecked="{Binding EqTargetChannel.IsEqEnabled}"
                                                  Background="#1E2434"
                                                  Foreground="#F8FAFC"
                                                  CornerRadius="6"
                                                  Height="30"
                                                  Padding="10,0"
                                                  FontWeight="Bold"
                                                  FontSize="10"
                                                  VerticalContentAlignment="Center">
                                        <TextBlock Text="EQ ON" VerticalAlignment="Center" />
                                    </ToggleButton>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding CloseEqEditorCommand}"
                                            Height="30"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <PathIcon Data="{StaticResource SvgClose}" Width="11" Height="11" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                            <TextBlock Text="CLOSE" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- 2. EQ PROFILE MANAGER & SAVER BAR -->
                        <Border Grid.Row="1"
                                Background="#0F131C"
                                BorderBrush="#202637"
                                BorderThickness="0,0,0,1"
                                Padding="20,12">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <!-- Preset / Saved Profile Selector Dropdown -->
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="LOAD EQ PROFILE (BUILT-IN &amp; SAVED)"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               LetterSpacing="0.8" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding AvailableEqProfiles}"
                                                  SelectedItem="{Binding SelectedEqProfile}"
                                                  Width="265"
                                                  Height="32"
                                                  Background="#171C28"
                                                  BorderBrush="#2B3347"
                                                  Foreground="#F8FAFC"
                                                  FontSize="12"
                                                  CornerRadius="6"
                                                  VerticalAlignment="Center" />
                                        <Button Classes="sonar-btn"
                                                Command="{Binding ResetActiveChannelEqToFlatCommand}"
                                                ToolTip.Tip="Reset all 10 bands to 0.0 dB (Flat)"
                                                Height="32"
                                                Padding="12,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource SvgRefresh}" Width="12" Height="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBlock Text="FLAT" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Save Custom EQ Profile Input & Buttons -->
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="PROFILE SAVER NAME"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="#64748B"
                                               LetterSpacing="0.8" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox Text="{Binding CustomEqProfileNameInput}"
                                                 Watermark="Enter profile name..."
                                                 Width="195"
                                                 Height="32"
                                                 Background="#171C28"
                                                 BorderBrush="#2B3347"
                                                 Foreground="#FFFFFF"
                                                 FontSize="12"
                                                 Padding="10,5"
                                                 CornerRadius="6"
                                                 VerticalAlignment="Center" />

                                        <Button Command="{Binding SaveCurrentEqProfileCommand}"
                                                Background="#FF5500"
                                                Foreground="#FFFFFF"
                                                CornerRadius="6"
                                                Height="32"
                                                Padding="14,0"
                                                VerticalAlignment="Center"
                                                Cursor="Hand"
                                                ToolTip.Tip="Save current 10-band curve as a reusable profile (.eqprofile.json)">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource SvgSave}" Width="12" Height="12" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                                <TextBlock Text="SAVE PROFILE" FontSize="11" FontWeight="ExtraBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="sonar-btn"
                                                IsVisible="{Binding CanDeleteSelectedEqProfile}"
                                                Command="{Binding DeleteSelectedEqProfileCommand}"
                                                Height="32"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Delete selected custom profile">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource SvgTrash}" Width="12" Height="12" Foreground="#FF4D6D" VerticalAlignment="Center" />
                                                <TextBlock Text="DELETE" FontSize="11" FontWeight="Bold" Foreground="#FF4D6D" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="sonar-btn"
                                                Command="{Binding OpenEqProfilesFolderCommand}"
                                                Height="32"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Open saved .eqprofile.json files folder in Windows Explorer">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <PathIcon Data="{StaticResource SvgFolder}" Width="12" Height="12" Foreground="#CBD5E1" VerticalAlignment="Center" />
                                                <TextBlock Text="PROFILES DIR" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- 3. INTERACTIVE FREQUENCY RESPONSE GRAPH -->
                        <Border Grid.Row="2"
                                Padding="20,14,20,8"
                                Background="#0D1018">
                            <Grid ColumnDefinitions="45,*">
                                <!-- dB Y-Axis Labels -->
                                <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Height="150" Margin="0,0,8,0">
                                    <TextBlock Grid.Row="0" Text="+12 dB" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="+6 dB" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="2" Text="0 dB" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="-6 dB" FontSize="9" Foreground="#475569" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Row="4" Text="-12 dB" FontSize="9" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>

                                <!-- Graph Canvas -->
                                <Border Grid.Column="1"
                                        Width="740"
                                        Height="150"
                                        HorizontalAlignment="Left"
                                        Background="#090B10"
                                        BorderBrush="#1E2436"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        ClipToBounds="True">
                                    <Canvas Width="740" Height="150">
                                        <!-- Horizontal dB Grid Lines -->
                                        <Line StartPoint="0,38" EndPoint="740,38" Stroke="#141824" StrokeThickness="1" />
                                        <Line StartPoint="0,75" EndPoint="740,75" Stroke="#232A3E" StrokeThickness="1.5" />
                                        <Line StartPoint="0,112" EndPoint="740,112" Stroke="#141824" StrokeThickness="1" />

                                        <!-- Vertical Octave Grid Lines -->
                                        <Line StartPoint="74,0" EndPoint="74,150" Stroke="#131722" StrokeThickness="1" />
                                        <Line StartPoint="156,0" EndPoint="156,150" Stroke="#131722" StrokeThickness="1" />
                                        <Line StartPoint="238,0" EndPoint="238,150" Stroke="#131722" StrokeThickness="1" />
                                        <Line StartPoint="320,0" EndPoint="320,150" Stroke="#131722" StrokeThickness="1" />
                                        <Line StartPoint="402,0" EndPoint="402,150" Stroke="#131722" StrokeThickness="1" />
                                        <Line StartPoint="484,0" EndPoint="484,150" Stroke="#131722" StrokeThickness="1" />
                                        <Line StartPoint="566,0" EndPoint="566,150" Stroke="#131722" StrokeThickness="1" />
                                        <Line StartPoint="648,0" EndPoint="648,150" Stroke="#131722" StrokeThickness="1" />

                                        <!-- Filled Glow Under Biquad Frequency Curve -->
                                        <Polygon Points="{Binding LargeEqFillPoints}"
                                                 Fill="{Binding EqTargetChannel.AccentGlowBrush}" />

                                        <!-- Main Biquad Frequency Response Curve -->
                                        <Polyline Points="{Binding LargeEqCurvePoints}"
                                                  Stroke="{Binding EqTargetChannel.AccentBrush}"
                                                  StrokeThickness="2.6" />
                                    </Canvas>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 4. PREAMP + 10-BAND VERTICAL FADERS -->
                        <Border Grid.Row="3"
                                Padding="20,10,20,18"
                                Background="#121621">
                            <Grid ColumnDefinitions="Auto,Auto,*">

                                <!-- Preamp Fader Column -->
                                <Border Grid.Column="0"
                                        Background="#0E111A"
                                        BorderBrush="#202637"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Width="86">
                                    <StackPanel Spacing="6" HorizontalAlignment="Center">
                                        <TextBlock Text="PREAMP"
                                                   FontSize="10"
                                                   FontWeight="Black"
                                                   Foreground="#94A3B8"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveEqPreampText}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#FF5500"
                                                   HorizontalAlignment="Center" />
                                        <Slider Orientation="Vertical"
                                                Minimum="-12"
                                                Maximum="12"
                                                Value="{Binding ActiveEqPreampDb}"
                                                Height="145"
                                                Foreground="#FF5500"
                                                HorizontalAlignment="Center" />
                                        <TextBlock Text="HEADROOM"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="#475569"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Divider -->
                                <Border Grid.Column="1"
                                        Width="1"
                                        Background="#22283A"
                                        Margin="14,6" />

                                <!-- 10 Frequency Band Faders (31Hz .. 16kHz) -->
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding ActiveEqBands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:EqBandViewModel">
                                            <Border Background="#0E111A"
                                                    BorderBrush="#1C2230"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="3,0"
                                                    Padding="4,8">
                                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                                    <!-- Gain Readout -->
                                                    <TextBlock Text="{Binding GainText}"
                                                               FontSize="10"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AccentBrush}"
                                                               HorizontalAlignment="Center" />

                                                    <!-- Band Vertical Slider (-12dB to +12dB) -->
                                                    <Slider Orientation="Vertical"
                                                            Minimum="-12"
                                                            Maximum="12"
                                                            Value="{Binding GainDb}"
                                                            Height="145"
                                                            Foreground="{Binding AccentBrush}"
                                                            HorizontalAlignment="Center" />

                                                    <!-- Frequency Label + Click to 0dB -->
                                                    <Button Classes="sonar-btn"
                                                            Command="{Binding ResetBandCommand}"
                                                            Height="22"
                                                            Padding="6,0"
                                                            ToolTip.Tip="Click to reset band to 0.0 dB"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding FrequencyLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="Bold"
                                                                   Foreground="#CBD5E1"
                                                                   VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Border>

        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2"
                Background="#0E1017"
                BorderBrush="#1B202C"
                BorderThickness="0,1,0,0"
                Padding="22,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#10B981" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"
                               LetterSpacing="0.6"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="WASAPI PER-APP SESSION ROUTER • DRAG &amp; DROP ENABLED"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#475569"
                           LetterSpacing="0.8"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
