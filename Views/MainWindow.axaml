<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TomatoMix.ViewModels"
        xmlns:theme="using:TomatoMix.Theme"
        x:Class="TomatoMix.Views.MainWindow"
        x:Name="RootWindow"
        Title="TOMATOMIX // AUDIO MIXER"
        Icon="avares://TomatoMix/Assets/app.ico"
        Width="1380"
        Height="860"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource TokenBg}"
        Foreground="{DynamicResource TokenText}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Constrain Sliders so they never overflow parent containers on window resize -->
        <Style Selector="Slider:horizontal">
            <Setter Property="MinWidth" Value="40" />
        </Style>
        <Style Selector="Slider:vertical">
            <Setter Property="MinHeight" Value="60" />
        </Style>

        <!-- Clean Rectangular Studio Fader Cap for Vertical Sliders -->
        <Style Selector="Slider:vertical /template/ Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="18"
                            Height="9"
                            CornerRadius="3"
                            Background="{DynamicResource TokenAccent}"
                            BorderBrush="{DynamicResource TokenSurface}"
                            BorderThickness="1" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Unified Wave Slider Style for App Cards (Hides default center line & uses a sleek vertical playhead pill thumb) -->
        <Style Selector="Slider.wave-slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Slider.wave-slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Slider.wave-slider /template/ Thumb">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="6"
                            Height="18"
                            CornerRadius="3"
                            Background="{DynamicResource TokenAccent}"
                            BorderBrush="{DynamicResource TokenSurface}"
                            BorderThickness="1" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.wave-slider:pointerover /template/ Thumb">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="7"
                            Height="20"
                            CornerRadius="3.5"
                            Background="{DynamicResource TokenAccent}"
                            BorderBrush="{DynamicResource TokenSurface}"
                            BorderThickness="1" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Unified Monochrome Secondary Button Style -->
        <Style Selector="Button.sonar-btn">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sonar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceInset}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorderStrong}" />
        </Style>

        <!-- Inverted Monochrome Accent Primary Button Style -->
        <Style Selector="Button.accent-btn">
            <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenAccentFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenAccentFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenTextMuted}" />
        </Style>

        <!-- Mute Toggle Button Style (Semantic Critical Status When Checked) -->
        <Style Selector="ToggleButton.mute-toggle">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.mute-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenStatusCriticalSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenStatusCritical}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenStatusCritical}" />
        </Style>

        <!-- Solo / Listen Toggle Button Style (Semantic Warning Status When Checked) -->
        <Style Selector="ToggleButton.solo-toggle">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.solo-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenStatusWarningSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenStatusWarning}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenStatusWarning}" />
        </Style>

        <!-- Monochrome Toggle Pill (EQ Enable / Audition) -->
        <Style Selector="ToggleButton.accent-toggle">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.accent-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenAccentFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
        </Style>

        <!-- Channel Card Style -->
        <Style Selector="Border.channel-strip">
            <Setter Property="Background" Value="{DynamicResource TokenSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- App Session Card Style -->
        <Style Selector="Border.app-card">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.app-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorderStrong}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ==================== TOP NAVIGATION & HEADER BAR ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource TokenSurface}"
                BorderBrush="{DynamicResource TokenBorder}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="{DynamicResource TokenAccent}">
                        <theme:ThemeIcon Icon="Settings"
                                         Width="16"
                                         Height="16"
                                         Foreground="{DynamicResource TokenAccentFg}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="TOMATOMIX"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Foreground="{DynamicResource TokenText}"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource TokenSurfaceInset}"
                                    BorderBrush="{DynamicResource TokenBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AUDIO MIXER"
                                           FontSize="9"
                                           FontWeight="Normal"
                                           LetterSpacing="0.6"
                                           Foreground="{DynamicResource TokenTextMuted}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Multi-Channel Application Audio Router &amp; Equalizer"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TokenTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Actions: Settings Menu Button -->
                <Button Grid.Column="2"
                        Classes="sonar-btn"
                        Width="34"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Settings &amp; Mixer Actions">
                    <theme:ThemeIcon Icon="Settings"
                                     Width="15"
                                     Height="15"
                                     Foreground="{DynamicResource TokenText}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <Border Background="{DynamicResource TokenSurface}"
                                    BorderBrush="{DynamicResource TokenBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8"
                                    MinWidth="220">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="MIXER SETTINGS"
                                               FontSize="9"
                                               FontWeight="Medium"
                                               LetterSpacing="0.6"
                                               Foreground="{DynamicResource TokenTextMuted}"
                                               Margin="4,2,4,2" />

                                    <Button Classes="sonar-btn"
                                            Command="{Binding ToggleThemeCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Height="32"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="{Binding ThemeToggleIcon}"
                                                             Width="13"
                                                             Height="13"
                                                             Foreground="{DynamicResource TokenText}"
                                                             VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding ThemeToggleLabel}"
                                                       FontSize="11"
                                                       FontWeight="Normal"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding RefreshDevicesAndSessionsCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Height="32"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Refresh"
                                                             Width="13"
                                                             Height="13"
                                                             Foreground="{DynamicResource TokenText}"
                                                             VerticalAlignment="Center" />
                                            <TextBlock Text="RESCAN"
                                                       FontSize="11"
                                                       FontWeight="Normal"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Classes="accent-btn"
                                            Command="{Binding OpenAddChannelPopupCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Height="32"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Plus"
                                                             Width="13"
                                                             Height="13"
                                                             Foreground="{DynamicResource TokenAccentFg}"
                                                             VerticalAlignment="Center" />
                                            <TextBlock Text="ADD CHANNEL"
                                                       FontSize="11"
                                                       FontWeight="Medium"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Border Height="1" Background="{DynamicResource TokenBorder}" Margin="0,2" />

                                    <TextBlock Text="BACKGROUND PROCESS"
                                               FontSize="9"
                                               FontWeight="Medium"
                                               LetterSpacing="0.6"
                                               Foreground="{DynamicResource TokenTextMuted}"
                                               Margin="4,2,4,2" />

                                    <ToggleButton Classes="accent-toggle"
                                                  IsChecked="{Binding CloseToTray}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  Height="30"
                                                  Padding="10,0"
                                                  ToolTip.Tip="Keep TomatoMix running in the Windows System Tray when closing the window">
                                        <TextBlock Text="CLOSE TO SYSTEM TRAY"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </ToggleButton>

                                    <ToggleButton Classes="accent-toggle"
                                                  IsChecked="{Binding MinimizeToTray}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  Height="30"
                                                  Padding="10,0"
                                                  ToolTip.Tip="Hide taskbar entry to System Tray when minimizing the window">
                                        <TextBlock Text="MINIMIZE TO SYSTEM TRAY"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </ToggleButton>

                                    <ToggleButton Classes="accent-toggle"
                                                  IsChecked="{Binding RunAtWindowsStartup}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  Height="30"
                                                  Padding="10,0"
                                                  ToolTip.Tip="Automatically start TomatoMix when logging into Windows">
                                        <TextBlock Text="START WITH WINDOWS"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </ToggleButton>

                                    <ToggleButton Classes="accent-toggle"
                                                  IsChecked="{Binding StartMinimizedToTray}"
                                                  HorizontalAlignment="Stretch"
                                                  HorizontalContentAlignment="Left"
                                                  Height="30"
                                                  Padding="10,0"
                                                  ToolTip.Tip="Launch directly into the background System Tray on startup">
                                        <TextBlock Text="START MINIMIZED IN TRAY"
                                                   FontSize="10"
                                                   VerticalAlignment="Center" />
                                    </ToggleButton>

                                    <Border Height="1" Background="{DynamicResource TokenBorder}" Margin="0,2" />

                                    <Button Classes="sonar-btn"
                                            Command="{Binding ExitApplicationCommand}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Height="30"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Close"
                                                             Width="12"
                                                             Height="12"
                                                             Foreground="{DynamicResource TokenStatusCritical}"
                                                             VerticalAlignment="Center" />
                                            <TextBlock Text="QUIT TOMATOMIX"
                                                       FontSize="10"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource TokenStatusCritical}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>

            </Grid>
        </Border>

        <!-- ==================== MAIN MIXER WORKSPACE (RESPONSIVE FULL-SCREEN EXPANSION) ==================== -->
        <Grid Grid.Row="1" Margin="14,12,14,10" ClipToBounds="True">
            <Grid ColumnDefinitions="200,*,195,200">

                <!-- 1. MASTER CHANNEL STRIP (Pinned Left with Playback Hardware Selector Underneath) -->
                <Border Grid.Column="0"
                        Classes="channel-strip"
                        Margin="0,0,5,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Header -->
                        <StackPanel Grid.Row="0">
                            <Border Padding="12,10"
                                    BorderBrush="{DynamicResource TokenBorder}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="24"
                                                    Height="24"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource TokenSurfaceInset}">
                                                <theme:ThemeIcon Icon="Layers"
                                                                 Width="13"
                                                                 Height="13"
                                                                 Foreground="{DynamicResource TokenText}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="MASTER"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="0.8"
                                                       Foreground="{DynamicResource TokenText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TokenSurfaceInset}"
                                                BorderBrush="{DynamicResource TokenBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="{Binding MasterStatusBrush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="MAIN OUT"
                                                           FontSize="9"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource TokenTextMuted}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Global Endpoint Mix"
                                               FontSize="11"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TokenTextMuted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Responsive Vertical Fader + Live VU Meter Section -->
                        <Border Grid.Row="1" Padding="12,10" ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">

                                <!-- Digital Volume Readout Pill -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource TokenSurfaceInset}"
                                        BorderBrush="{DynamicResource TokenBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,3"
                                        HorizontalAlignment="Center"
                                        MinWidth="76"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding MasterVolumePercentText}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TokenText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Flexible Fader + VU Meter Track (Scales with window height) -->
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto,*"
                                      MinHeight="70"
                                      MaxHeight="200"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Center"
                                      ClipToBounds="True">

                                    <!-- dB Scale Labels -->
                                    <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,4,8,4" HorizontalAlignment="Right">
                                        <TextBlock Grid.Row="0" Text="100" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="75" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="2" Text="50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="3" Text="25" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="4" Text="0" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Vertical Fader Slider -->
                                    <Slider Grid.Column="1"
                                            Orientation="Vertical"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding MasterVolumePercent}"
                                            VerticalAlignment="Stretch"
                                            Foreground="{DynamicResource TokenAccent}"
                                            HorizontalAlignment="Center" />

                                    <!-- Responsive Live Vertical Peak VU Meter -->
                                    <ProgressBar Grid.Column="2"
                                                 Orientation="Vertical"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding MasterPeakLevel}"
                                                 Width="10"
                                                 MinWidth="10"
                                                 MinHeight="40"
                                                 Margin="10,4,0,4"
                                                 CornerRadius="5"
                                                 Background="{DynamicResource TokenSurfaceInset}"
                                                 BorderBrush="{DynamicResource TokenBorder}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource TokenVuMeterGradient}"
                                                 VerticalAlignment="Stretch" />
                                </Grid>

                                <!-- Master Mute & Clear Solo Buttons -->
                                <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                    <ToggleButton Classes="mute-toggle"
                                                  IsChecked="{Binding IsMasterMuted}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="30">
                                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Close" Width="11" Height="11" VerticalAlignment="Center" />
                                            <TextBlock Text="MUTE MASTER" FontSize="11" FontWeight="Normal" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding ClearAllSolosCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="28">
                                        <TextBlock Text="CLEAR ALL SOLOS" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Playback Hardware Selector (Under Master) -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource TokenSurfaceRaised}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="12,10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="PLAYBACK HARDWARE"
                                           FontSize="10"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TokenTextMuted}"
                                           LetterSpacing="0.5" />
                                <ComboBox ItemsSource="{Binding OutputDevices}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          HorizontalAlignment="Stretch"
                                          Background="{DynamicResource TokenSurface}"
                                          BorderBrush="{DynamicResource TokenBorder}"
                                          Foreground="{DynamicResource TokenText}"
                                          FontSize="11"
                                          CornerRadius="6" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- 2. CHANNELS GRID (EXPANDS PROPORTIONALLY TO FILL FULL SCREEN) -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Channels}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              ClipToBounds="True">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ChannelViewModel">
                            <Border Classes="channel-strip"
                                    Margin="5,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    DragDrop.AllowDrop="True">
                                <Grid RowDefinitions="Auto,1.15*,*" ClipToBounds="True">

                                    <!-- A. CHANNEL HEADER BAR -->
                                    <StackPanel Grid.Row="0">
                                        <Border Padding="12,10"
                                                BorderBrush="{DynamicResource TokenBorder}"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <!-- Channel Typed Icon + Status Dot + Name / Rename TextBox -->
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" ClipToBounds="True">
                                                    <Border Width="24"
                                                            Height="24"
                                                            CornerRadius="6"
                                                            Background="{DynamicResource TokenSurfaceInset}">
                                                        <theme:ThemeIcon Icon="{Binding ChannelIcon}"
                                                                         Width="13"
                                                                         Height="13"
                                                                         Foreground="{DynamicResource TokenText}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                    </Border>

                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="{Binding StatusBrush}"
                                                             VerticalAlignment="Center" />

                                                    <TextBlock Text="{Binding Name}"
                                                               IsVisible="{Binding !IsEditingName}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               LetterSpacing="0.8"
                                                               Foreground="{DynamicResource TokenText}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <TextBox Text="{Binding Name}"
                                                             IsVisible="{Binding IsEditingName}"
                                                             MinWidth="70"
                                                             FontSize="12"
                                                             FontWeight="Normal"
                                                             Padding="6,2"
                                                             Background="{DynamicResource TokenSurfaceInset}"
                                                             BorderBrush="{DynamicResource TokenBorderStrong}"
                                                             Foreground="{DynamicResource TokenText}"
                                                             VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- Rename / Delete Controls -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button Classes="sonar-btn"
                                                            Command="{Binding ToggleEditNameCommand}"
                                                            ToolTip.Tip="Rename Channel"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0">
                                                        <theme:ThemeIcon Icon="Edit"
                                                                         Width="11"
                                                                         Height="11"
                                                                         Foreground="{DynamicResource TokenTextMuted}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                    </Button>
                                                    <Button Classes="sonar-btn"
                                                            IsVisible="{Binding CanDelete}"
                                                            Command="{Binding DeleteChannelCommand}"
                                                            ToolTip.Tip="Delete Custom Channel"
                                                            Width="24"
                                                            Height="24"
                                                            Padding="0">
                                                        <theme:ThemeIcon Icon="Trash"
                                                                         Width="11"
                                                                         Height="11"
                                                                         Foreground="{DynamicResource TokenStatusCritical}"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- B. RESPONSIVE VERTICAL FADER + LIVE PEAK METER + MUTE/SOLO + MINI EQ -->
                                    <Border Grid.Row="1"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource TokenBorder}"
                                            BorderThickness="0,0,0,1"
                                            ClipToBounds="True">
                                        <Grid RowDefinitions="Auto,*,Auto,Auto" ClipToBounds="True">

                                            <!-- Volume Readout Pill -->
                                            <Border Grid.Row="0"
                                                    Background="{DynamicResource TokenSurfaceInset}"
                                                    BorderBrush="{DynamicResource TokenBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,3"
                                                    HorizontalAlignment="Center"
                                                    MinWidth="72"
                                                    Margin="0,0,0,6">
                                                <TextBlock Text="{Binding VolumePercentText}"
                                                           FontSize="13"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TokenText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <!-- Flexible Vertical Slider + Peak Bar (Shrinks/Expands cleanly on resize) -->
                                            <Grid Grid.Row="1"
                                                  ColumnDefinitions="*,Auto,Auto,*"
                                                  MinHeight="65"
                                                  MaxHeight="185"
                                                  VerticalAlignment="Stretch"
                                                  HorizontalAlignment="Center"
                                                  ClipToBounds="True">

                                                <!-- Tick Marks -->
                                                <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,4,8,4">
                                                    <TextBlock Grid.Row="0" Text="100" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="1" Text="75" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="2" Text="50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="3" Text="25" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                                    <TextBlock Grid.Row="4" Text="0" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>

                                                <!-- Channel Volume Fader -->
                                                <Slider Grid.Column="1"
                                                        Orientation="Vertical"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Value="{Binding VolumePercent}"
                                                        VerticalAlignment="Stretch"
                                                        Foreground="{DynamicResource TokenAccent}"
                                                        HorizontalAlignment="Center" />

                                                <!-- Responsive Live Channel VU Meter -->
                                                <ProgressBar Grid.Column="2"
                                                             Orientation="Vertical"
                                                             Minimum="0"
                                                             Maximum="100"
                                                             Value="{Binding PeakLevel}"
                                                             Width="10"
                                                             MinWidth="10"
                                                             MinHeight="40"
                                                             Margin="10,4,0,4"
                                                             CornerRadius="5"
                                                             Background="{DynamicResource TokenSurfaceInset}"
                                                             BorderBrush="{DynamicResource TokenBorder}"
                                                             BorderThickness="1"
                                                             Foreground="{DynamicResource TokenAccent}"
                                                             VerticalAlignment="Stretch" />
                                            </Grid>

                                            <!-- MUTE & SOLO Buttons -->
                                            <Grid Grid.Row="2" ColumnDefinitions="*,6,*" Margin="0,6,0,0">
                                                <ToggleButton Grid.Column="0"
                                                              Classes="mute-toggle"
                                                              IsChecked="{Binding IsMuted}"
                                                              HorizontalAlignment="Stretch"
                                                              Height="28"
                                                              Padding="4,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <theme:ThemeIcon Icon="Close" Width="10" Height="10" VerticalAlignment="Center" />
                                                        <TextBlock Text="MUTE" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>

                                                <ToggleButton Grid.Column="2"
                                                              Classes="solo-toggle"
                                                              IsChecked="{Binding IsSolo}"
                                                              HorizontalAlignment="Stretch"
                                                              Height="28"
                                                              Padding="4,0">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <theme:ThemeIcon Icon="Star" Width="10" Height="10" VerticalAlignment="Center" />
                                                        <TextBlock Text="SOLO" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </ToggleButton>
                                            </Grid>

                                            <!-- PER-CHANNEL MINI EQ PREVIEW & STUDIO BUTTON -->
                                            <Border Grid.Row="3"
                                                    Margin="0,6,0,0"
                                                    Background="{DynamicResource TokenSurfaceInset}"
                                                    BorderBrush="{DynamicResource TokenBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="7"
                                                    Padding="7,5"
                                                    ClipToBounds="True">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                        <ToggleButton Grid.Column="0"
                                                                      Classes="accent-toggle"
                                                                      IsChecked="{Binding IsEqEnabled}"
                                                                      Width="30"
                                                                      Height="20"
                                                                      Padding="0"
                                                                      CornerRadius="4"
                                                                      FontSize="9"
                                                                      FontWeight="Medium"
                                                                      Content="EQ"
                                                                      VerticalAlignment="Center"
                                                                      ToolTip.Tip="Enable / Bypass Channel Equalizer" />

                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding EqStatusBadgeText}"
                                                                   FontSize="9"
                                                                   FontWeight="Normal"
                                                                   Foreground="{DynamicResource TokenTextMuted}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Margin="6,0"
                                                                   VerticalAlignment="Center"
                                                                   ToolTip.Tip="{Binding ActiveEqProfileName}" />

                                                        <Button Grid.Column="2"
                                                                Classes="sonar-btn"
                                                                Command="{Binding OpenEqEditorCommand}"
                                                                Height="20"
                                                                Padding="6,0"
                                                                VerticalAlignment="Center"
                                                                ToolTip.Tip="Open 10-Band EQ &amp; Profile Saver">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <theme:ThemeIcon Icon="Tunnel" Width="10" Height="10" Foreground="{DynamicResource TokenText}" VerticalAlignment="Center" />
                                                                <TextBlock Text="EQ" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TokenText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>

                                                    <!-- Mini Live Frequency Response Curve -->
                                                    <Button Command="{Binding OpenEqEditorCommand}"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Cursor="Hand"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch">
                                                        <Viewbox Stretch="Fill" Height="28">
                                                            <Canvas Width="220" Height="36" ClipToBounds="True">
                                                                <Line StartPoint="0,18" EndPoint="220,18" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                                                <Polygon Points="{Binding MiniEqFillPoints}"
                                                                         Fill="{DynamicResource TokenAccentSubtle}" />
                                                                <Polyline Points="{Binding MiniEqCurvePoints}"
                                                                          Stroke="{DynamicResource TokenAccent}"
                                                                          StrokeThickness="1.8" />
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                        </Grid>
                                    </Border>

                                    <!-- C. ROUTED APPLICATIONS SECTION -->
                                    <Grid Grid.Row="2" RowDefinitions="Auto,*" Margin="10,8,10,10" ClipToBounds="True">
                                        <!-- Section Header -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,2,6">
                                            <TextBlock Text="ROUTED APPS"
                                                       FontSize="10"
                                                       FontWeight="Medium"
                                                       LetterSpacing="0.6"
                                                       Foreground="{DynamicResource TokenTextMuted}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource TokenSurfaceInset}"
                                                    BorderBrush="{DynamicResource TokenBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="6,1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding AppCount}"
                                                           FontSize="10"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource TokenText}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Scrollable App Cards List + Empty Drop Zone -->
                                        <Grid Grid.Row="1" ClipToBounds="True">
                                            <!-- Empty Drop Placeholder -->
                                            <Border IsVisible="{Binding HasNoApps}"
                                                    BorderBrush="{DynamicResource TokenBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Background="{DynamicResource TokenSurfaceInset}"
                                                    Padding="10"
                                                    ClipToBounds="True">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                    <theme:ThemeIcon Icon="Download"
                                                                     Width="16"
                                                                     Height="16"
                                                                     Foreground="{DynamicResource TokenTextFaint}"
                                                                     HorizontalAlignment="Center" />
                                                    <TextBlock Text="DROP APPS HERE"
                                                               FontSize="10"
                                                               FontWeight="Medium"
                                                               LetterSpacing="0.5"
                                                               Foreground="{DynamicResource TokenTextMuted}"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock Text="Drag an app card here to route audio"
                                                               FontSize="10"
                                                               FontWeight="Normal"
                                                               Foreground="{DynamicResource TokenTextFaint}"
                                                               TextAlignment="Center"
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Routed App Cards -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl ItemsSource="{Binding Apps}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>

                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:AppSessionViewModel">
                                                            <Border Classes="app-card"
                                                                    Padding="8,7"
                                                                    PointerPressed="OnAppCardPointerPressed">
                                                                <StackPanel Spacing="5" ClipToBounds="True">

                                                                    <!-- Row 1: Grip + App Icon + Name + Status + Mute + Move Channel Menu -->
                                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" VerticalAlignment="Center">
                                                                        <theme:ThemeIcon Grid.Column="0"
                                                                                         Icon="Grip"
                                                                                         Width="10"
                                                                                         Height="10"
                                                                                         Margin="0,0,5,0"
                                                                                         Foreground="{DynamicResource TokenTextFaint}"
                                                                                         VerticalAlignment="Center" />

                                                                        <!-- App Icon or Initials -->
                                                                        <Grid Grid.Column="1" Width="22" Height="22" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                            <Border CornerRadius="5"
                                                                                    Background="{DynamicResource TokenSurfaceInset}"
                                                                                    BorderBrush="{DynamicResource TokenBorder}"
                                                                                    BorderThickness="1"
                                                                                    IsVisible="{Binding AppIcon, Converter={x:Static ObjectConverters.IsNull}}">
                                                                                <TextBlock Text="{Binding Initials}"
                                                                                           FontSize="9"
                                                                                           FontWeight="Medium"
                                                                                           Foreground="{DynamicResource TokenText}"
                                                                                           HorizontalAlignment="Center"
                                                                                           VerticalAlignment="Center" />
                                                                            </Border>
                                                                            <Image Source="{Binding AppIcon}"
                                                                                   Width="20"
                                                                                   Height="20"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding AppIcon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                                        </Grid>

                                                                        <!-- App Display Name -->
                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding DisplayName}"
                                                                                   FontSize="11"
                                                                                   FontWeight="Normal"
                                                                                   Foreground="{DynamicResource TokenText}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"
                                                                                   ToolTip.Tip="{Binding DisplayName}" />

                                                                        <!-- Semantic Session Status Dot -->
                                                                        <Ellipse Grid.Column="3"
                                                                                 Width="6"
                                                                                 Height="6"
                                                                                 Margin="4,0"
                                                                                 Fill="{Binding StatusBrush}"
                                                                                 VerticalAlignment="Center" />

                                                                        <!-- App Trim Mute Toggle -->
                                                                        <ToggleButton Grid.Column="4"
                                                                                      Classes="mute-toggle"
                                                                                      IsChecked="{Binding IsMuted}"
                                                                                      Width="24"
                                                                                      Height="22"
                                                                                      Padding="0"
                                                                                      Margin="2,0,3,0"
                                                                                      VerticalAlignment="Center"
                                                                                      ToolTip.Tip="Mute Application">
                                                                            <theme:ThemeIcon Icon="Close" Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </ToggleButton>

                                                                        <!-- Route App to Another Channel Button -->
                                                                        <Button Grid.Column="5"
                                                                                Classes="sonar-btn"
                                                                                Width="24"
                                                                                Height="22"
                                                                                Padding="0"
                                                                                VerticalAlignment="Center"
                                                                                Click="OnRouteAppButtonClick"
                                                                                ToolTip.Tip="Move App to Another Channel">
                                                                            <theme:ThemeIcon Icon="Sftp" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- Row 2: Unified Volume Slider + Live Animated EQ Wave Track -->
                                                                    <Border Background="{DynamicResource TokenSurfaceInset}"
                                                                            BorderBrush="{DynamicResource TokenBorder}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Height="26"
                                                                            Padding="6,0"
                                                                            ClipToBounds="True">
                                                                        <Grid ColumnDefinitions="Auto,*,34" VerticalAlignment="Center">

                                                                            <!-- Mini 4-Bar Animated EQ Equalizer Indicator -->
                                                                            <StackPanel Grid.Column="0"
                                                                                        Orientation="Horizontal"
                                                                                        Spacing="2"
                                                                                        Height="14"
                                                                                        Margin="0,0,6,0"
                                                                                        VerticalAlignment="Center">
                                                                                <Border Width="2"
                                                                                        Height="{Binding EqBar1Height}"
                                                                                        CornerRadius="1"
                                                                                        Background="{DynamicResource TokenAccent}"
                                                                                        VerticalAlignment="Bottom" />
                                                                                <Border Width="2"
                                                                                        Height="{Binding EqBar2Height}"
                                                                                        CornerRadius="1"
                                                                                        Background="{DynamicResource TokenAccent}"
                                                                                        VerticalAlignment="Bottom" />
                                                                                <Border Width="2"
                                                                                        Height="{Binding EqBar3Height}"
                                                                                        CornerRadius="1"
                                                                                        Background="{DynamicResource TokenAccent}"
                                                                                        VerticalAlignment="Bottom" />
                                                                                <Border Width="2"
                                                                                        Height="{Binding EqBar4Height}"
                                                                                        CornerRadius="1"
                                                                                        Background="{DynamicResource TokenAccent}"
                                                                                        VerticalAlignment="Bottom" />
                                                                            </StackPanel>

                                                                            <!-- Combined Live Audio Waveform Canvas + Interactive Volume Slider -->
                                                                            <Grid Grid.Column="1" Height="22" VerticalAlignment="Center" ClipToBounds="True">
                                                                                <!-- Subtle Volume Fill Curtain (0% .. RelativeVolume%) -->
                                                                                <ProgressBar Minimum="0"
                                                                                             Maximum="100"
                                                                                             Value="{Binding RelativeVolume}"
                                                                                             Height="20"
                                                                                             MinWidth="10"
                                                                                             CornerRadius="4"
                                                                                             Background="Transparent"
                                                                                             Foreground="{DynamicResource TokenAccentSubtle}"
                                                                                             VerticalAlignment="Center"
                                                                                             IsHitTestVisible="False" />

                                                                                <!-- Subtle Center Baseline -->
                                                                                <Border Height="1"
                                                                                        Background="{DynamicResource TokenBorder}"
                                                                                        VerticalAlignment="Center"
                                                                                        IsHitTestVisible="False" />

                                                                                <!-- Live Oscillating EQ Wave Backdrop inside the Slider Track -->
                                                                                <Viewbox Stretch="Fill" Height="22" VerticalAlignment="Center" IsHitTestVisible="False">
                                                                                    <Canvas Width="180" Height="22" ClipToBounds="True">
                                                                                        <Polygon Points="{Binding WaveFillPoints}"
                                                                                                 Fill="{DynamicResource TokenAccentSubtle}" />
                                                                                        <Polyline Points="{Binding WaveCurvePoints}"
                                                                                                  Stroke="{DynamicResource TokenAccent}"
                                                                                                  StrokeThickness="1.3" />
                                                                                    </Canvas>
                                                                                </Viewbox>

                                                                                <!-- Interactive App Volume Slider (Sleek Vertical Playhead Pill) -->
                                                                                <Slider Classes="wave-slider"
                                                                                        Minimum="0"
                                                                                        Maximum="100"
                                                                                        Value="{Binding RelativeVolume}"
                                                                                        Foreground="{DynamicResource TokenAccent}"
                                                                                        VerticalAlignment="Center" />
                                                                            </Grid>

                                                                            <!-- Volume Percentage Readout -->
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding VolumePercentText}"
                                                                                       FontSize="10"
                                                                                       FontWeight="Normal"
                                                                                       Foreground="{DynamicResource TokenTextMuted}"
                                                                                       HorizontalAlignment="Right"
                                                                                       VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Grid>
                                    </Grid>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 3. DEDICATED CHATMIX CHANNEL STRIP (Vertical Crossfader in Channel Strip Style) -->
                <Border Grid.Column="2"
                        Classes="channel-strip"
                        Margin="5,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Header -->
                        <StackPanel Grid.Row="0">
                            <Border Padding="12,10"
                                    BorderBrush="{DynamicResource TokenBorder}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="24"
                                                    Height="24"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource TokenSurfaceInset}">
                                                <theme:ThemeIcon Icon="Sftp"
                                                                 Width="13"
                                                                 Height="13"
                                                                 Foreground="{DynamicResource TokenText}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="CHATMIX"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="0.8"
                                                       Foreground="{DynamicResource TokenText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TokenSurfaceInset}"
                                                BorderBrush="{DynamicResource TokenBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <TextBlock Text="BALANCE"
                                                       FontSize="9"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource TokenTextMuted}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Game vs. Chat Fader"
                                               FontSize="11"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TokenTextMuted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Responsive Vertical Balance Fader + Dual Game/Chat VU Meters -->
                        <Border Grid.Row="1"
                                Padding="12,10"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="0,0,0,1"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*,Auto" ClipToBounds="True">

                                <!-- Balance Readout Pill -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource TokenSurfaceInset}"
                                        BorderBrush="{DynamicResource TokenBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,3"
                                        HorizontalAlignment="Center"
                                        MinWidth="86"
                                        Margin="0,0,0,8">
                                    <TextBlock Text="{Binding ChatMixLabelText}"
                                               FontSize="12"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TokenText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Vertical Crossfader + Dual Live Game/Chat VU Meters -->
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto,Auto,*"
                                      MinHeight="70"
                                      MaxHeight="200"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Center"
                                      ClipToBounds="True">

                                    <!-- Balance Scale Labels (Top = CHAT, Center = 0, Bottom = GAME) -->
                                    <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,4,8,4" HorizontalAlignment="Right">
                                        <TextBlock Grid.Row="0" Text="CHAT" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextMuted}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="+50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="2" Text="0" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TokenText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <TextBlock Grid.Row="3" Text="-50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="4" Text="GAME" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Vertical Balance Slider (-100 Game .. 0 Balanced .. +100 Chat) -->
                                    <Slider Grid.Column="1"
                                            Orientation="Vertical"
                                            Minimum="-100"
                                            Maximum="100"
                                            Value="{Binding ChatMixBalance}"
                                            VerticalAlignment="Stretch"
                                            Foreground="{DynamicResource TokenAccent}"
                                            HorizontalAlignment="Center" />

                                    <!-- Live Game VU Meter -->
                                    <ProgressBar Grid.Column="2"
                                                 Orientation="Vertical"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding GameChannelPeakLevel}"
                                                 Width="8"
                                                 MinWidth="8"
                                                 MinHeight="40"
                                                 Margin="10,4,0,4"
                                                 CornerRadius="4"
                                                 Background="{DynamicResource TokenSurfaceInset}"
                                                 BorderBrush="{DynamicResource TokenBorder}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource TokenAccent}"
                                                 VerticalAlignment="Stretch"
                                                 ToolTip.Tip="Live Game Channel Level" />

                                    <!-- Live Chat VU Meter -->
                                    <ProgressBar Grid.Column="3"
                                                 Orientation="Vertical"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding ChatChannelPeakLevel}"
                                                 Width="8"
                                                 MinWidth="8"
                                                 MinHeight="40"
                                                 Margin="4,4,0,4"
                                                 CornerRadius="4"
                                                 Background="{DynamicResource TokenSurfaceInset}"
                                                 BorderBrush="{DynamicResource TokenBorder}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource TokenTextMuted}"
                                                 VerticalAlignment="Stretch"
                                                 ToolTip.Tip="Live Chat Channel Level" />
                                </Grid>

                                <!-- Quick Bias & Center Reset Buttons (Matches Master/Channel Button Row) -->
                                <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                                    <Grid ColumnDefinitions="*,6,*">
                                        <Button Grid.Column="0"
                                                Classes="sonar-btn"
                                                Command="{Binding SetChatMixPresetCommand}"
                                                CommandParameter="-50"
                                                HorizontalAlignment="Stretch"
                                                Height="30"
                                                Padding="4,0"
                                                ToolTip.Tip="Bias toward Game (+50%)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <theme:ThemeIcon Icon="Dashboard" Width="10" Height="10" VerticalAlignment="Center" />
                                                <TextBlock Text="GAME" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Grid.Column="2"
                                                Classes="sonar-btn"
                                                Command="{Binding SetChatMixPresetCommand}"
                                                CommandParameter="50"
                                                HorizontalAlignment="Stretch"
                                                Height="30"
                                                Padding="4,0"
                                                ToolTip.Tip="Bias toward Chat (+50%)">
                                            <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <theme:ThemeIcon Icon="Telegram" Width="10" Height="10" VerticalAlignment="Center" />
                                                <TextBlock Text="CHAT" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding ResetChatMixCommand}"
                                            HorizontalAlignment="Stretch"
                                            Height="28">
                                        <TextBlock Text="CENTER (50 / 50)" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- Effective Game vs. Chat Gain Readout (Matches Bottom Section of Master & Mic) -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource TokenSurfaceRaised}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <!-- Game Effective Gain Bar -->
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="GAME GAIN"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TokenTextMuted}"
                                                   LetterSpacing="0.5" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding GameMixPercentText}"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TokenText}" />
                                    </Grid>
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding GameMixPercent}"
                                                 Height="4"
                                                 MinWidth="20"
                                                 CornerRadius="2"
                                                 Background="{DynamicResource TokenSurfaceInset}"
                                                 Foreground="{DynamicResource TokenAccent}" />
                                </StackPanel>

                                <!-- Chat Effective Gain Bar -->
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="CHAT GAIN"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TokenTextMuted}"
                                                   LetterSpacing="0.5" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ChatMixPercentText}"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TokenText}" />
                                    </Grid>
                                    <ProgressBar Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding ChatMixPercent}"
                                                 Height="4"
                                                 MinWidth="20"
                                                 CornerRadius="2"
                                                 Background="{DynamicResource TokenSurfaceInset}"
                                                 Foreground="{DynamicResource TokenAccent}" />
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource TokenBorder}" />

                                <TextBlock Text="Attenuates Chat when pulled down toward Game, or attenuates Game when pushed up toward Chat."
                                           FontSize="10"
                                           FontWeight="Normal"
                                           Foreground="{DynamicResource TokenTextFaint}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

                <!-- 4. DEDICATED MIC CHANNEL STRIP (Pinned Right with Capture Hardware Selector Underneath) -->
                <Border Grid.Column="3"
                        Classes="channel-strip"
                        Margin="5,0,0,0">
                    <Grid RowDefinitions="Auto,*,Auto">

                        <!-- Header -->
                        <StackPanel Grid.Row="0">
                            <Border Padding="12,10"
                                    BorderBrush="{DynamicResource TokenBorder}"
                                    BorderThickness="0,0,0,1">
                                <StackPanel Spacing="3">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <Border Width="24"
                                                    Height="24"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource TokenSurfaceInset}">
                                                <theme:ThemeIcon Icon="Tunnel"
                                                                 Width="13"
                                                                 Height="13"
                                                                 Foreground="{DynamicResource TokenText}"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="MIC"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="0.8"
                                                       Foreground="{DynamicResource TokenText}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource TokenSurfaceInset}"
                                                BorderBrush="{DynamicResource TokenBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="{Binding MicChannel.StatusBrush}"
                                                         VerticalAlignment="Center" />
                                                <TextBlock Text="CAPTURE IN"
                                                           FontSize="9"
                                                           FontWeight="Normal"
                                                           Foreground="{DynamicResource TokenTextMuted}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Microphone Input &amp; Voice DSP"
                                               FontSize="11"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TokenTextMuted}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Responsive Vertical Mic Gain Fader + VU Meter + Mute/Listen + Mini EQ -->
                        <Border Grid.Row="1"
                                Padding="12,8"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="0,0,0,1"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*,Auto,Auto" ClipToBounds="True">

                                <!-- Digital Mic Gain Readout Pill -->
                                <Border Grid.Row="0"
                                        Background="{DynamicResource TokenSurfaceInset}"
                                        BorderBrush="{DynamicResource TokenBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,3"
                                        HorizontalAlignment="Center"
                                        MinWidth="76"
                                        Margin="0,0,0,6">
                                    <TextBlock Text="{Binding MicChannel.VolumePercentText}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TokenText}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <!-- Flexible Fader + VU Meter Track -->
                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto,Auto,*"
                                      MinHeight="65"
                                      MaxHeight="185"
                                      VerticalAlignment="Stretch"
                                      HorizontalAlignment="Center"
                                      ClipToBounds="True">

                                    <!-- dB Scale Labels -->
                                    <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Margin="0,4,8,4" HorizontalAlignment="Right">
                                        <TextBlock Grid.Row="0" Text="100" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="1" Text="75" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="2" Text="50" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="3" Text="25" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Row="4" Text="0" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>

                                    <!-- Vertical Mic Gain Slider -->
                                    <Slider Grid.Column="1"
                                            Orientation="Vertical"
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding MicChannel.VolumePercent}"
                                            VerticalAlignment="Stretch"
                                            Foreground="{DynamicResource TokenAccent}"
                                            HorizontalAlignment="Center" />

                                    <!-- Responsive Live Vertical Mic Peak VU Meter -->
                                    <ProgressBar Grid.Column="2"
                                                 Orientation="Vertical"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding MicChannel.PeakLevel}"
                                                 Width="10"
                                                 MinWidth="10"
                                                 MinHeight="40"
                                                 Margin="10,4,0,4"
                                                 CornerRadius="5"
                                                 Background="{DynamicResource TokenSurfaceInset}"
                                                 BorderBrush="{DynamicResource TokenBorder}"
                                                 BorderThickness="1"
                                                 Foreground="{DynamicResource TokenAccent}"
                                                 VerticalAlignment="Stretch" />
                                </Grid>

                                <!-- Mic MUTE & LISTEN (Sidetone) Buttons -->
                                <Grid Grid.Row="2" ColumnDefinitions="*,6,*" Margin="0,6,0,0">
                                    <ToggleButton Grid.Column="0"
                                                  Classes="mute-toggle"
                                                  IsChecked="{Binding MicChannel.IsMuted}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="28"
                                                  Padding="4,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Close" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="MUTE" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <ToggleButton Grid.Column="2"
                                                  Classes="solo-toggle"
                                                  IsChecked="{Binding IsMicMonitoring}"
                                                  HorizontalAlignment="Stretch"
                                                  Height="28"
                                                  Padding="4,0"
                                                  ToolTip.Tip="Listen to your Microphone in real time with the 10-band Mic EQ applied (Sidetone)">
                                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Eye" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="LISTEN" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>
                                </Grid>

                                <!-- MIC MINI EQ PREVIEW & STUDIO BUTTON -->
                                <Border Grid.Row="3"
                                        Margin="0,6,0,0"
                                        Background="{DynamicResource TokenSurfaceInset}"
                                        BorderBrush="{DynamicResource TokenBorder}"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Padding="7,5"
                                        ClipToBounds="True">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                            <ToggleButton Grid.Column="0"
                                                          Classes="accent-toggle"
                                                          IsChecked="{Binding MicChannel.IsEqEnabled}"
                                                          Width="30"
                                                          Height="20"
                                                          Padding="0"
                                                          CornerRadius="4"
                                                          FontSize="9"
                                                          FontWeight="Medium"
                                                          Content="EQ"
                                                          VerticalAlignment="Center"
                                                          ToolTip.Tip="Enable / Bypass Microphone Equalizer" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding MicChannel.EqStatusBadgeText}"
                                                       FontSize="9"
                                                       FontWeight="Normal"
                                                       Foreground="{DynamicResource TokenTextMuted}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="6,0"
                                                       VerticalAlignment="Center"
                                                       ToolTip.Tip="{Binding MicChannel.ActiveEqProfileName}" />

                                            <Button Grid.Column="2"
                                                    Classes="sonar-btn"
                                                    Command="{Binding OpenMicEqStudioCommand}"
                                                    Height="20"
                                                    Padding="6,0"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="Open 10-Band Microphone Equalizer">
                                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <theme:ThemeIcon Icon="Tunnel" Width="10" Height="10" Foreground="{DynamicResource TokenText}" VerticalAlignment="Center" />
                                                    <TextBlock Text="EQ" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TokenText}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Mini Live Mic Frequency Response Curve -->
                                        <Button Command="{Binding OpenMicEqStudioCommand}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch">
                                            <Viewbox Stretch="Fill" Height="28">
                                                <Canvas Width="220" Height="36" ClipToBounds="True">
                                                    <Line StartPoint="0,18" EndPoint="220,18" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                                    <Polygon Points="{Binding MicChannel.MiniEqFillPoints}"
                                                             Fill="{DynamicResource TokenAccentSubtle}" />
                                                    <Polyline Points="{Binding MicChannel.MiniEqCurvePoints}"
                                                              Stroke="{DynamicResource TokenAccent}"
                                                              StrokeThickness="1.8" />
                                                </Canvas>
                                            </Viewbox>
                                        </Button>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                        <!-- Microphone Hardware Selector (Under Mic Strip) -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource TokenSurfaceRaised}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="0,1,0,0"
                                CornerRadius="0,0,10,10"
                                Padding="12,10">
                            <StackPanel Spacing="8">
                                <!-- Mic Input Hardware Dropdown -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="MIC INPUT HARDWARE"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TokenTextMuted}"
                                               LetterSpacing="0.5" />
                                    <ComboBox ItemsSource="{Binding InputDevices}"
                                              SelectedItem="{Binding SelectedMicDevice}"
                                              HorizontalAlignment="Stretch"
                                              Background="{DynamicResource TokenSurface}"
                                              BorderBrush="{DynamicResource TokenBorder}"
                                              Foreground="{DynamicResource TokenText}"
                                              FontSize="11"
                                              CornerRadius="6" />
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource TokenBorder}" />

                                <!-- Mic Sidetone / Voice DSP Status -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="VOICE CAPTURE ENGINE"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               LetterSpacing="0.5"
                                               Foreground="{DynamicResource TokenTextMuted}" />
                                    <TextBlock Text="Controls Windows WASAPI Microphone gain &amp; mute. Toggle LISTEN to monitor your voice with live 10-band EQ."
                                               FontSize="10"
                                               FontWeight="Normal"
                                               Foreground="{DynamicResource TokenTextFaint}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Border>

            </Grid>

            <!-- ==================== ADD CUSTOM CHANNEL MODAL OVERLAY ==================== -->
            <Border IsVisible="{Binding IsAddChannelPopupOpen}"
                    Background="{DynamicResource TokenBackdrop}"
                    CornerRadius="10">
                <Border Width="380"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource TokenSurface}"
                        BorderBrush="{DynamicResource TokenBorderStrong}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="22">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="CREATE CUSTOM CHANNEL"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       LetterSpacing="0.8"
                                       Foreground="{DynamicResource TokenText}" />
                            <TextBlock Text="Add a new logical audio group to your mixer."
                                       FontSize="12"
                                       FontWeight="Normal"
                                       Foreground="{DynamicResource TokenTextMuted}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Text="CHANNEL NAME"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       LetterSpacing="0.6"
                                       Foreground="{DynamicResource TokenTextMuted}" />
                            <TextBox Text="{Binding NewChannelName}"
                                     Watermark="e.g. BROWSER, MUSIC, STREAM"
                                     Background="{DynamicResource TokenSurfaceInset}"
                                     BorderBrush="{DynamicResource TokenBorder}"
                                     Foreground="{DynamicResource TokenText}"
                                     FontSize="13"
                                     Padding="10,8"
                                     CornerRadius="6" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="CHANNEL ICON"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       LetterSpacing="0.6"
                                       Foreground="{DynamicResource TokenTextMuted}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="sonar-btn" Command="{Binding SelectNewChannelIconCommand}" CommandParameter="settings" Width="36" Height="36" Padding="0">
                                    <theme:ThemeIcon Icon="Settings" Width="14" Height="14" />
                                </Button>
                                <Button Classes="sonar-btn" Command="{Binding SelectNewChannelIconCommand}" CommandParameter="dashboard" Width="36" Height="36" Padding="0">
                                    <theme:ThemeIcon Icon="Dashboard" Width="14" Height="14" />
                                </Button>
                                <Button Classes="sonar-btn" Command="{Binding SelectNewChannelIconCommand}" CommandParameter="terminal" Width="36" Height="36" Padding="0">
                                    <theme:ThemeIcon Icon="Terminal" Width="14" Height="14" />
                                </Button>
                                <Button Classes="sonar-btn" Command="{Binding SelectNewChannelIconCommand}" CommandParameter="play" Width="36" Height="36" Padding="0">
                                    <theme:ThemeIcon Icon="Play" Width="14" Height="14" />
                                </Button>
                                <Button Classes="sonar-btn" Command="{Binding SelectNewChannelIconCommand}" CommandParameter="layers" Width="36" Height="36" Padding="0">
                                    <theme:ThemeIcon Icon="Layers" Width="14" Height="14" />
                                </Button>
                                <Button Classes="sonar-btn" Command="{Binding SelectNewChannelIconCommand}" CommandParameter="star" Width="36" Height="36" Padding="0">
                                    <theme:ThemeIcon Icon="Star" Width="14" Height="14" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <Grid ColumnDefinitions="*,10,*" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Classes="sonar-btn"
                                    Content="CANCEL"
                                    Command="{Binding CancelAddChannelCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="36" />
                            <Button Grid.Column="2"
                                    Classes="accent-btn"
                                    Content="CREATE CHANNEL"
                                    Command="{Binding ConfirmAddChannelCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="36" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ==================== 10-BAND PARAMETRIC EQ & PROFILE SAVER MODAL ==================== -->
            <Border IsVisible="{Binding IsEqEditorOpen}"
                    Background="{DynamicResource TokenBackdrop}"
                    CornerRadius="10">
                <Border MaxWidth="940"
                        Margin="20"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource TokenSurface}"
                        BorderBrush="{DynamicResource TokenBorderStrong}"
                        BorderThickness="1"
                        CornerRadius="12"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto">

                        <!-- 1. EQ Header Bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource TokenSurfaceRaised}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="18,12">
                            <Grid ColumnDefinitions="*,Auto">

                                <!-- Title & Active Channel Badge -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Border Width="6"
                                            Height="26"
                                            CornerRadius="3"
                                            Background="{DynamicResource TokenAccent}" />
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="10-BAND CHANNEL EQUALIZER"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="0.8"
                                                       Foreground="{DynamicResource TokenText}"
                                                       VerticalAlignment="Center" />
                                            <Border Background="{DynamicResource TokenSurfaceInset}"
                                                    BorderBrush="{DynamicResource TokenBorderStrong}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding EqTargetChannel.Name}"
                                                           FontSize="10"
                                                           FontWeight="Medium"
                                                           Foreground="{DynamicResource TokenText}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Customize per-channel frequency curve, preamp headroom, and save reusable EQ profiles"
                                                   FontSize="11"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TokenTextMuted}" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Enable Toggle, Live Audition Loop, APO Hook & Close Button -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <ToggleButton Classes="accent-toggle"
                                                  IsChecked="{Binding IsAuditioningEq}"
                                                  Height="28"
                                                  Padding="10,0"
                                                  FontWeight="Normal"
                                                  FontSize="10"
                                                  ToolTip.Tip="Play built-in full-spectrum test synth loop through the live C# 10-Band Biquad DSP engine to immediately hear EQ changes">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Play" Width="11" Height="11" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding AuditionButtonText}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </ToggleButton>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding OpenOrInstallEqualizerApoCommand}"
                                            Height="28"
                                            Padding="10,0"
                                            ToolTip.Tip="{Binding ApoStatusText}">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Fill="{Binding ApoStatusBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Text="APO HOOK" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <ToggleButton Classes="accent-toggle"
                                                  IsChecked="{Binding EqTargetChannel.IsEqEnabled}"
                                                  Height="28"
                                                  Padding="10,0"
                                                  FontWeight="Normal"
                                                  FontSize="10">
                                        <TextBlock Text="EQ ON" VerticalAlignment="Center" />
                                    </ToggleButton>

                                    <Button Classes="sonar-btn"
                                            Command="{Binding CloseEqEditorCommand}"
                                            Height="28"
                                            Padding="10,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <theme:ThemeIcon Icon="Close" Width="10" Height="10" Foreground="{DynamicResource TokenTextMuted}" VerticalAlignment="Center" />
                                            <TextBlock Text="CLOSE" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- 2. EQ PROFILE MANAGER & SAVER BAR -->
                        <Border Grid.Row="1"
                                Background="{DynamicResource TokenSurface}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="0,0,0,1"
                                Padding="18,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <!-- Preset / Saved Profile Selector Dropdown -->
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="LOAD EQ PROFILE (BUILT-IN &amp; SAVED)"
                                               FontSize="9"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TokenTextMuted}"
                                               LetterSpacing="0.5" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <ComboBox ItemsSource="{Binding AvailableEqProfiles}"
                                                  SelectedItem="{Binding SelectedEqProfile}"
                                                  Width="245"
                                                  Height="30"
                                                  Background="{DynamicResource TokenSurfaceInset}"
                                                  BorderBrush="{DynamicResource TokenBorder}"
                                                  Foreground="{DynamicResource TokenText}"
                                                  FontSize="11"
                                                  CornerRadius="6"
                                                  VerticalAlignment="Center" />
                                        <Button Classes="sonar-btn"
                                                Command="{Binding ResetActiveChannelEqToFlatCommand}"
                                                ToolTip.Tip="Reset all 10 bands to 0.0 dB (Flat)"
                                                Height="30"
                                                Padding="10,0"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <theme:ThemeIcon Icon="Refresh" Width="11" Height="11" Foreground="{DynamicResource TokenText}" VerticalAlignment="Center" />
                                                <TextBlock Text="FLAT" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Save Custom EQ Profile Input & Buttons -->
                                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="PROFILE SAVER NAME"
                                               FontSize="9"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource TokenTextMuted}"
                                               LetterSpacing="0.5" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBox Text="{Binding CustomEqProfileNameInput}"
                                                 Watermark="Enter profile name..."
                                                 Width="180"
                                                 Height="30"
                                                 Background="{DynamicResource TokenSurfaceInset}"
                                                 BorderBrush="{DynamicResource TokenBorder}"
                                                 Foreground="{DynamicResource TokenText}"
                                                 FontSize="11"
                                                 Padding="10,4"
                                                 CornerRadius="6"
                                                 VerticalAlignment="Center" />

                                        <Button Classes="accent-btn"
                                                Command="{Binding SaveCurrentEqProfileCommand}"
                                                Height="30"
                                                Padding="12,0"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Save current 10-band curve as a reusable profile (.eqprofile.json)">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <theme:ThemeIcon Icon="Check" Width="11" Height="11" Foreground="{DynamicResource TokenAccentFg}" VerticalAlignment="Center" />
                                                <TextBlock Text="SAVE PROFILE" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="sonar-btn"
                                                IsVisible="{Binding CanDeleteSelectedEqProfile}"
                                                Command="{Binding DeleteSelectedEqProfileCommand}"
                                                Height="30"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Delete selected custom profile">
                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                <theme:ThemeIcon Icon="Trash" Width="11" Height="11" Foreground="{DynamicResource TokenStatusCritical}" VerticalAlignment="Center" />
                                                <TextBlock Text="DELETE" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource TokenStatusCritical}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>

                                        <Button Classes="sonar-btn"
                                                Command="{Binding OpenEqProfilesFolderCommand}"
                                                Height="30"
                                                Padding="10,0"
                                                VerticalAlignment="Center"
                                                ToolTip.Tip="Open saved .eqprofile.json files folder in Windows Explorer">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <theme:ThemeIcon Icon="Folder" Width="11" Height="11" Foreground="{DynamicResource TokenTextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Text="PROFILES DIR" FontSize="10" FontWeight="Normal" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                            </Grid>
                        </Border>

                        <!-- 3. INTERACTIVE FREQUENCY RESPONSE GRAPH -->
                        <Border Grid.Row="2"
                                Padding="18,12,18,8"
                                Background="{DynamicResource TokenBg}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="45,*">
                                <!-- dB Y-Axis Labels -->
                                <Grid Grid.Column="0" RowDefinitions="*,*,*,*,*" Height="130" Margin="0,0,8,0">
                                    <TextBlock Grid.Row="0" Text="+12 dB" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextMuted}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="+6 dB" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="2" Text="0 dB" FontSize="9" FontWeight="Medium" Foreground="{DynamicResource TokenText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="-6 dB" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextFaint}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    <TextBlock Grid.Row="4" Text="-12 dB" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource TokenTextMuted}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>

                                <!-- Responsive Graph Canvas -->
                                <Border Grid.Column="1"
                                        Height="130"
                                        HorizontalAlignment="Stretch"
                                        Background="{DynamicResource TokenSurfaceInset}"
                                        BorderBrush="{DynamicResource TokenBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        ClipToBounds="True">
                                    <Viewbox Stretch="Fill">
                                        <Canvas Width="740" Height="150" ClipToBounds="True">
                                            <!-- Horizontal dB Grid Lines -->
                                            <Line StartPoint="0,38" EndPoint="740,38" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="0,75" EndPoint="740,75" Stroke="{DynamicResource TokenBorderStrong}" StrokeThickness="1.5" />
                                            <Line StartPoint="0,112" EndPoint="740,112" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />

                                            <!-- Vertical Octave Grid Lines -->
                                            <Line StartPoint="74,0" EndPoint="74,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="156,0" EndPoint="156,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="238,0" EndPoint="238,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="320,0" EndPoint="320,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="402,0" EndPoint="402,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="484,0" EndPoint="484,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="566,0" EndPoint="566,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />
                                            <Line StartPoint="648,0" EndPoint="648,150" Stroke="{DynamicResource TokenBorder}" StrokeThickness="1" />

                                            <!-- Filled Monochrome Shade Under Biquad Frequency Curve -->
                                            <Polygon Points="{Binding LargeEqFillPoints}"
                                                     Fill="{DynamicResource TokenAccentSubtle}" />

                                            <!-- Main Biquad Frequency Response Curve -->
                                            <Polyline Points="{Binding LargeEqCurvePoints}"
                                                      Stroke="{DynamicResource TokenAccent}"
                                                      StrokeThickness="2.6" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 4. PREAMP + 10-BAND VERTICAL FADERS -->
                        <Border Grid.Row="3"
                                Padding="18,10,18,14"
                                Background="{DynamicResource TokenSurface}"
                                ClipToBounds="True">
                            <Grid ColumnDefinitions="Auto,Auto,*">

                                <!-- Preamp Fader Column -->
                                <Border Grid.Column="0"
                                        Background="{DynamicResource TokenSurfaceRaised}"
                                        BorderBrush="{DynamicResource TokenBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Width="80"
                                        ClipToBounds="True">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="PREAMP"
                                                   FontSize="10"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TokenTextMuted}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding ActiveEqPreampText}"
                                                   FontSize="10"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TokenText}"
                                                   HorizontalAlignment="Center" />
                                        <Slider Orientation="Vertical"
                                                Minimum="-12"
                                                Maximum="12"
                                                Value="{Binding ActiveEqPreampDb}"
                                                Height="125"
                                                Foreground="{DynamicResource TokenAccent}"
                                                HorizontalAlignment="Center" />
                                        <TextBlock Text="HEADROOM"
                                                   FontSize="8"
                                                   FontWeight="Normal"
                                                   Foreground="{DynamicResource TokenTextFaint}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Divider -->
                                <Border Grid.Column="1"
                                        Width="1"
                                        Background="{DynamicResource TokenBorder}"
                                        Margin="12,6" />

                                <!-- 10 Frequency Band Faders (31Hz .. 16kHz) -->
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding ActiveEqBands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:EqBandViewModel">
                                            <Border Background="{DynamicResource TokenSurfaceRaised}"
                                                    BorderBrush="{DynamicResource TokenBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="3,0"
                                                    Padding="4,8"
                                                    ClipToBounds="True">
                                                <StackPanel Spacing="5" HorizontalAlignment="Center">
                                                    <!-- Gain Readout -->
                                                    <TextBlock Text="{Binding GainText}"
                                                               FontSize="10"
                                                               FontWeight="Normal"
                                                               Foreground="{DynamicResource TokenText}"
                                                               HorizontalAlignment="Center" />

                                                    <!-- Band Vertical Slider (-12dB to +12dB) -->
                                                    <Slider Orientation="Vertical"
                                                            Minimum="-12"
                                                            Maximum="12"
                                                            Value="{Binding GainDb}"
                                                            Height="125"
                                                            Foreground="{DynamicResource TokenAccent}"
                                                            HorizontalAlignment="Center" />

                                                    <!-- Frequency Label + Click to 0dB -->
                                                    <Button Classes="sonar-btn"
                                                            Command="{Binding ResetBandCommand}"
                                                            Height="20"
                                                            Padding="5,0"
                                                            ToolTip.Tip="Click to reset band to 0.0 dB"
                                                            HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding FrequencyLabel}"
                                                                   FontSize="9"
                                                                   FontWeight="Normal"
                                                                   Foreground="{DynamicResource TokenTextMuted}"
                                                                   VerticalAlignment="Center" />
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </Grid>
                        </Border>

                    </Grid>
                </Border>
            </Border>

        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource TokenSurface}"
                BorderBrush="{DynamicResource TokenBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{Binding EngineStatusBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TokenTextMuted}"
                               LetterSpacing="0.4"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Active Audio Apps Counter + Background Process Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{DynamicResource TokenSurfaceInset}"
                            BorderBrush="{DynamicResource TokenBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding BackgroundStatusBadgeText}"
                                   FontSize="9"
                                   FontWeight="Medium"
                                   LetterSpacing="0.5"
                                   Foreground="{DynamicResource TokenTextMuted}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="{DynamicResource TokenSurfaceInset}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalRoutedAppsCount}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TokenText}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ACTIVE AUDIO APPS"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TokenTextMuted}"
                                   LetterSpacing="0.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
