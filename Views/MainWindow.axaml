<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:TomatoMix.Views"
        xmlns:theme="using:TomatoMix.Theme"
        x:Class="TomatoMix.Views.MainWindow"
        x:Name="RootWindow"
        Title="TOMATOMIX // AUDIO MIXER"
        Icon="avares://TomatoMix/Assets/app.ico"
        Width="1380"
        Height="860"
        MinWidth="920"
        MinHeight="620"
        Background="{DynamicResource TokenBg}"
        Foreground="{DynamicResource TokenText}"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Constrain Sliders so they never overflow parent containers on window resize -->
        <Style Selector="Slider:horizontal">
            <Setter Property="MinWidth" Value="40" />
        </Style>
        <Style Selector="Slider:vertical">
            <Setter Property="MinHeight" Value="60" />
        </Style>

        <!-- Individual Channel Fader: fixed max height in normal window, scales up on full screen -->
        <Style Selector="Grid.channel-fader-grid">
            <Setter Property="MaxHeight" Value="185" />
        </Style>
        <Style Selector="Window[WindowState=Maximized] Grid.channel-fader-grid, Window[WindowState=FullScreen] Grid.channel-fader-grid">
            <Setter Property="MaxHeight" Value="Infinity" />
        </Style>

        <!-- Clean Rectangular Studio Fader Cap for Vertical Sliders -->
        <Style Selector="Slider:vertical /template/ Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="18"
                            Height="9"
                            CornerRadius="3"
                            Background="{DynamicResource TokenAccent}"
                            BorderBrush="{DynamicResource TokenSurface}"
                            BorderThickness="1" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Unified Wave Slider Style for App Cards (Hides default center line & uses a sleek vertical playhead pill thumb) -->
        <Style Selector="Slider.wave-slider /template/ RepeatButton#PART_DecreaseButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Slider.wave-slider /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Slider.wave-slider /template/ Thumb">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="6"
                            Height="18"
                            CornerRadius="3"
                            Background="{DynamicResource TokenAccent}"
                            BorderBrush="{DynamicResource TokenSurface}"
                            BorderThickness="1" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Slider.wave-slider:pointerover /template/ Thumb">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Width="7"
                            Height="20"
                            CornerRadius="3.5"
                            Background="{DynamicResource TokenAccent}"
                            BorderBrush="{DynamicResource TokenSurface}"
                            BorderThickness="1" />
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Unified Monochrome Secondary Button Style -->
        <Style Selector="Button.sonar-btn">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.sonar-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceInset}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorderStrong}" />
        </Style>

        <!-- Inverted Monochrome Accent Primary Button Style -->
        <Style Selector="Button.accent-btn">
            <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenAccentFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.accent-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenAccentFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenTextMuted}" />
        </Style>

        <!-- Mute Toggle Button Style (Semantic Critical Status When Checked) -->
        <Style Selector="ToggleButton.mute-toggle">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.mute-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenStatusCriticalSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenStatusCritical}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenStatusCritical}" />
        </Style>

        <!-- Solo / Listen Toggle Button Style (Semantic Warning Status When Checked) -->
        <Style Selector="ToggleButton.solo-toggle">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.solo-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenStatusWarningSubtle}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenStatusWarning}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenStatusWarning}" />
        </Style>

        <!-- Monochrome Toggle Pill (EQ Enable / Audition) -->
        <Style Selector="ToggleButton.accent-toggle">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenTextMuted}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="ToggleButton.accent-toggle:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TokenAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource TokenAccentFg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenAccent}" />
        </Style>

        <!-- Channel Card Style -->
        <Style Selector="Border.channel-strip">
            <Setter Property="Background" Value="{DynamicResource TokenSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <!-- App Session Card Style -->
        <Style Selector="Border.app-card">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceRaised}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.app-card:pointerover">
            <Setter Property="Background" Value="{DynamicResource TokenSurfaceInset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource TokenBorderStrong}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ==================== TOP NAVIGATION & HEADER BAR ==================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource TokenSurface}"
                BorderBrush="{DynamicResource TokenBorder}"
                BorderThickness="0,0,0,1"
                Padding="18,10">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <!-- Brand Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="34"
                            Height="34"
                            CornerRadius="8"
                            Background="{DynamicResource TokenAccent}">
                        <theme:ThemeIcon Icon="Settings"
                                         Width="16"
                                         Height="16"
                                         Foreground="{DynamicResource TokenAccentFg}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="TOMATOMIX"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Foreground="{DynamicResource TokenText}"
                                       VerticalAlignment="Center" />
                            <Border Background="{DynamicResource TokenSurfaceInset}"
                                    BorderBrush="{DynamicResource TokenBorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AUDIO MIXER"
                                           FontSize="9"
                                           FontWeight="Normal"
                                           LetterSpacing="0.6"
                                           Foreground="{DynamicResource TokenTextMuted}"
                                           VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Multi-Channel Application Audio Router &amp; Equalizer"
                                   FontSize="11"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TokenTextMuted}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right Actions: Settings Menu Button -->
                <Button Grid.Column="2"
                        Classes="sonar-btn"
                        Width="34"
                        Height="34"
                        Padding="0"
                        VerticalAlignment="Center"
                        Command="{Binding OpenSettingsPageCommand}"
                        ToolTip.Tip="Settings">
                    <theme:ThemeIcon Icon="Settings"
                                     Width="15"
                                     Height="15"
                                     Foreground="{DynamicResource TokenText}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                </Button>

            </Grid>
        </Border>

        <!-- ==================== UPDATE NOTIFICATION BANNER ==================== -->
        <Border Grid.Row="1"
                IsVisible="{Binding IsUpdateAvailable}"
                Background="{DynamicResource TokenAccentSubtle}"
                BorderBrush="{DynamicResource TokenAccent}"
                BorderThickness="0,0,0,1"
                Padding="18,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Text="{Binding UpdateNotificationText}"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TokenText}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           TextWrapping="Wrap" />
                <Button Grid.Column="1"
                        Classes="accent-btn"
                        Content="VIEW RELEASE"
                        Command="{Binding OpenLatestReleaseCommand}"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Classes="sonar-btn"
                        Content="DISMISS"
                        Command="{Binding DismissUpdateNotificationCommand}"
                        VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ==================== MAIN MIXER WORKSPACE (RESPONSIVE FULL-SCREEN EXPANSION) ==================== -->
        <Grid Grid.Row="2" Margin="14,12,14,10" ClipToBounds="True">
            <Grid ColumnDefinitions="200,*,195,200">
                <!-- 1. MASTER CHANNEL STRIP -->
                <views:MasterStripView Grid.Column="0" />

                <!-- 2. CHANNELS GRID -->
                <views:ChannelsGridView Grid.Column="1" />

                <!-- 3. DEDICATED CHATMIX CHANNEL STRIP -->
                <views:ChatMixStripView Grid.Column="2" />

                <!-- 4. DEDICATED MIC CHANNEL STRIP -->
                <views:MicStripView Grid.Column="3" />
            </Grid>

            <!-- ==================== MODAL OVERLAYS ==================== -->
            <views:AddChannelModalView />
            <views:EqStudioModalView />
            <views:SettingsModalView />
        </Grid>

        <!-- ==================== BOTTOM STATUS BAR ==================== -->
        <Border Grid.Row="3"
                Background="{DynamicResource TokenSurface}"
                BorderBrush="{DynamicResource TokenBorder}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{Binding EngineStatusBrush}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="{DynamicResource TokenTextMuted}"
                               LetterSpacing="0.4"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Active Audio Apps Counter + Background Process Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Background="{DynamicResource TokenSurfaceInset}"
                            BorderBrush="{DynamicResource TokenBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding BackgroundStatusBadgeText}"
                                   FontSize="9"
                                   FontWeight="Medium"
                                   LetterSpacing="0.5"
                                   Foreground="{DynamicResource TokenTextMuted}"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Border Background="{DynamicResource TokenSurfaceInset}"
                                BorderBrush="{DynamicResource TokenBorder}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,1"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalRoutedAppsCount}"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{DynamicResource TokenText}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="ACTIVE AUDIO APPS"
                                   FontSize="10"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource TokenTextMuted}"
                                   LetterSpacing="0.5"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
