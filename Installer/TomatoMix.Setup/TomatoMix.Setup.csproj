<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>TomatoMix-Setup</AssemblyName>
    <ApplicationIcon>..\..\Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>TomatoMix Audio Mixer Setup</Product>
    <Company>TomatoMix</Company>
    <Description>TomatoMix Audio Mixer Installer &amp; Uninstaller</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')" LogicalName="TomatoMix.Payload.zip" />
    <EmbeddedResource Include="..\..\Assets\app.ico" LogicalName="TomatoMix.App.ico" />
  </ItemGroup>

</Project>
